        <div id="pdsingle" class="row price-range-blk" ng-controller="single">
            @if (ViewBag.sku < 1)
            {
                <input type="hidden" id="category_id" name="category_id" data-ttlno="@((ViewBag.sku) * 1000)" value="@Model.Tables[0].Rows[0]["MinOrderQty"]" />
            }
