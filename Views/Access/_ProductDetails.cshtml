                                    <button type="submit" data-toggle="tooltip" data-original-title="The product is already added to your cart, if you wish to update your quantity, please visit your CART" id="gocart" style="cursor:pointer;" onclick="location.href='@Url.Action("cart", "Home")'" class=@(TempData["InCart"].ToString() == "true" ? "buy-now" : "d-none" )>GO TO CART</button>
                                    <button type="submit" id="addcart" class=@(TempData["InCart"].ToString() == "true" ? "d-none" : "btn-cart") onclick='addcart("add")' style="cursor:pointer;">ADD TO CART</button>

