                    <div class="col-lg-6 pricing-info" ng-init="total= @ViewBag.Rate; ttlsku= @ViewBag.sku; price=@ViewBag.price">
                        <div class="d-flex">
                            <div class="prc-info">
                                <span><small>  @( ViewBag.sku >= 1 ? "Per Kg" : "Price")</small></span>
                                <span>BHD {{price | number : 3}}/-</span>
                            </div>
                            <div class="prc-qty">
                                <span><small>Total Qty</small></span>

                                @if (ViewBag.sku < 1)
                                {
                                    ViewBag.WT = (ViewBag.sku) * 1000;
                                    <span>
                                        @(Convert.ToInt32(ViewBag.WT).toString("N3")) @( ViewBag.sku >= 1 ? "KG" : "GM")
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        {{ttlsku | number:2}} @( ViewBag.sku >= 1 ? "KG" : "GM")
                                    </span>

                                }

                            </div>
                        </div>
                        <div class="prc-total">
                            <span><small>Total Price</small></span>
                            <span>BHD {{total | number : 3}}</span>
                        </div>
                        <div class="row">

                            @if (Model.Tables[0].Rows[0]["Product_Onorder"].ToString() == "True") // && Model.Tables[0].Rows[0]["Product_Stock"].ToString() != "In Stock")
                            {
                                <div class="col-md-12 col-12  mt-3 mt-md-0">
                                    <button id="req-quo1" class="text-center req-quote side-panel-trigger prc-Quote btn-cart" style="cursor:pointer;">NOTIFY ME WHEN AVAILABLE</button>
                                </div>
                            }
                            else if (Model.Tables[0].Rows[0]["Product_Onorder"].ToString() != "True")
