                                    <input type="number" min="1" max="999" class="pack-qty" maxlength="3" @(Model.Tables[0].Rows[0]["Product_linkas"].ToString() == "Sample" ? "disabled" : "" ) ng-model="pack" [ng-pattern="integer" ] @*onkeyup="cal(this);"*@ onchange="cal(this);" onkeypress="return Qtynumkey(this);" />
                                </div>
                                <div class="col-md-6 col-12 mt-3 mt-md-0">
