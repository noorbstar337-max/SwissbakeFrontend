                                                    DataRow newDr = Model.Tables[5].Rows[row];
                                                    double maxkg = ((Convert.ToDouble((newDr["endSKU"]).ToString())) - Convert.ToDouble(i["Packing_Weight"]));
                                                    <div>
                                                        <label class="prc-mn" ng-class="{'active' : ttlsku >= @i["startSKU"] && ttlsku <= @maxkg}">
