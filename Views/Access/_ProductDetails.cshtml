                                foreach (DataRow i in Model.Tables[count].Rows)
                                {
                                    //ViewBag.Rate = Convert.ToDouble(i["Product_Rate"]) * Convert.ToDouble(i["Packing_Weight"]);
                                    ViewBag.Rate = Convert.ToDouble(i["Product_Rate"]);
                                    ViewBag.price = Convert.ToDouble(i["Product_Rate"]);
                                    ViewBag.sku = i["Packing_Weight"];
                                    @*<div class="col-md-3 col-6">*@ <div class="prc-mn">
                                        <label class="prc-mn">
                                            <input type="radio" name="range" ng-model="rangevalue" ng-value="1" class="d-none" ng-change="selectrange(rangevalue)" />
