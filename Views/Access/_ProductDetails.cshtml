                                                    <label class="prc-mn" ng-class="{'active' : ttlsku >= @i["startSKU"] && ttlsku <= @i["endSKU"]}">

                                                        <input type="radio" name="range" ng-model="rangevalue" ng-value="@i["startSKU"]"/>
