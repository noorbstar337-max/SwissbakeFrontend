@using System.Data
@model DataSet
@using SwissbakeIn.Entities;
@using SwissbakeIn.App_Start;
@if (HttpContext.Current.Request.Url.Host == "localhost")
{
    ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
}
else
{
    ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
}

@if (Request.UrlReferrer.Segments[1] != "trackorder" && Request.UrlReferrer.Segments[2] != "trackorder")
{
    <div class="order-tabs">

        <ul>
            <li class="@ViewBag.Act1"><a href="/account/invoice">MY&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["allInvoice"])</a></li>
            <li class="@ViewBag.Act2"><a href="/account/cancelinvoice">CANCEL&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Cancelled"])</a></li>
            <li class="@ViewBag.Act3"><a href="/account/pendinginvoice">PENDING&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Pending"])</a></li>
            <li class="@ViewBag.Act4"><a href="/account/dispatchinvoice">DISPATCHED&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Dispatched"])</a></li>
            <li class="@ViewBag.Act5"><a href="/account/deliveredinvoice">DELIVERED&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Delivered"])</a></li>
        </ul>

        <select class="form-control mb-5" onchange="window.location.href=this.value">
            <option value="/account/invoice" @ViewBag.Act1 >ALL&nbsp;INVOICES&nbsp;(@Model.Tables[1].Rows[0]["allInvoice"])</option>
            <option value="/account/cancelinvoice" @ViewBag.Act2 >CANCELLED&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Cancelled"])</option>
            <option value="/account/pendinginvoice" @ViewBag.Act3 >PENDING&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Pending"])</option>
            <option value="/account/dispatchinvoice" @ViewBag.Act4 >DISPATCHED&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Dispatched"])</option>
            <option value="/account/deliveredinvoice" @ViewBag.Act5 >DELIVERED&nbsp;INVOICE&nbsp;(@Model.Tables[1].Rows[0]["Delivered"])</option>
        </select>
</div>
}


<table id="datatable1" class="table table-striped table-bordered w-100 table-responsive" cellspacing="0">
    @if (Request.Url.Segments[2] == "AwbTrack" && Model.Tables[0].Rows.Count == 0)
    {

    }
    else
    {
        <text>
            <thead>
                <tr>
                    <th>Invoice&nbsp;No.</th>
                    <th>Order&nbsp;No.</th>
                    @if(Request.Url.Segments[2] == "AwbTrack" || Request.Url.Segments[2] == "Track")
                    {
                        <th>AWB&nbsp;No.</th>
                    }
                    <th>Invoice&nbsp;Date</th>
                    <th>Invoice&nbsp;Amount</th>
                    <th>Status</th>
                    <th>Track&nbsp;Order</th>
                </tr>
            </thead>
        </text>
    }

        <tbody>
            @if (Model.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in Model.Tables[0].Rows)
                {
                    <tr>
                        <td>
                            <a href="@ViewBag.domain/@Convert.ToString(row["hrefinvoice"] + HttpUtility.UrlEncode(Helper.Encrypt(row["Invoice_ID"].ToString())))" target="_blank">
                                @row["Invoice_Number"].ToString() <i class="fas fa-eye"></i>
                            </a>
                        </td>
                        <td>
                            <a href="@ViewBag.domain/@Convert.ToString(row["hreforder"] + HttpUtility.UrlEncode(Helper.Encrypt(row["Order_ID"].ToString())) + "&fr="+Helper.Encrypt(row["Order_Freight"].ToString()) + "&Status=" + row["Order_OrderStatus"])"  target="_blank">
                                @row["Order_Code"].ToString() <i class="fas fa-eye"></i>
                            </a>
                        </td>
                        @if (Request.Url.Segments[2] == "AwbTrack" || Request.Url.Segments[2] == "Track")
                        {
                            <td>@row["Invoice_AWB"].ToString()</td>
                        }
                        <td>@row["Invoice_Date"].ToString()</td>
                        <td>BHD @Helper.InPrice(Convert.ToDouble(row["Invoice_Amount"]))</td>
                        <td><span class="@Helper.GetStatus(row["Invoice_Status"].ToString())">@row["Invoice_Status"]</span></td>
                        <td>
                            @if (row["hreftracking"].ToString() == "Direct")
                            {
                                <text><b class="primary-color">Direct</b></text>
                            }
                            else if (row["Invoice_AWB"].ToString() != "")
                            {
                                <a href="@row["hreftracking"].ToString()" target="_blank"><i class="fas fa-truck"></i></a>
                            }

                            else if (row["Invoice_AWB"].ToString() == "")
                            {
                                <text>-</text>
                            }

                            @*<button type="submit" class="paynow">Pay Now!</button>*@
                        </td>
                    </tr>
                }
            }
            else if(Request.Url.Segments[2] == "AwbTrack" && Model.Tables[0].Rows.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">No record found</td>
                </tr>
            }


        </tbody>
</table>