@using System.Data
@using SwissbakeIn.Entities;
@model DataSet
@{
    //ViewBag.Title = @ViewBag.Title;


    //ViewBag.Title = "Search";

    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
    Layout = "~/Views/Shared/_Layout.cshtml";




}

@section head{
    <link rel="stylesheet/less" type="text/css" href="~/Content/css/less/products.less" />
    <style>
        .jconfirm .jconfirm-box div.jconfirm-content-pane {
            margin-bottom: 0;
        }

        .jconfirm-closeIcon {
            display: none !important;
        }

        .blgartsec hr, .bakercpsec hr, .faqsec  hr{
            margin-bottom: 3rem;
        }

        .bakercpsec .blog-card {
            height: 350px !important;
        }

            .bakercpsec .blog-card .product {
                transition-property: none !important;
                transition-duration: 0s !important;
                transition-delay: 0ms !important;
                transform: translate3d(0px,0px,0px) !important;
            }


        @@media screen and (min-width: 991px) {
        .w-100 {
            width: 98.2% !important;
        }
        }

        @@media screen and (min-width: 576px) and (max-width: 990px) {
            .w-100 {
                width: 97.5% !important;
            }
        }
        

    </style>
}
@section foot{
    @*<script src="~/Content/js/account.js"></script>
        <script src="~/Content/js/components/bs-datatable.js"></script>*@
    <script>

        $(document).ready(function () {
            // $('#datatable1').dataTable();
            $("#topsearch,#search").val("@ViewBag.search.Replace("-"," ")");

            $(".togglet").click();

            get("@ViewBag.search");
            //$('select[name=Year]').click(function () {
            //    //$('button[name=yearsubmit]').click();
            //    getOrder($("select[name=Year]").val(), $("#type").val());
            //});
        });
        function get(url) {

            var id = '@Session["U_Id"]';
            var path = window.location.pathname;
            var paths = path.split("/");
            if (paths[1] == "search"){
                var m = "search"
            }
            else if (paths[1] == "exclusive") {
                var m = "exclusive";
                if (id == ""){
                    window.location.href = "/login";
                }
            }

            if (id == '' || id == null)
            {
                id = 0;
            }
             $.ajax({
                 url: '@Url.Action("Product","Access",null)',
                    type: "Post",
                    beforeSend: function () {
                        //_divPartialView.style = "Display: none";
                        //$("#divWaiting").removeClass("display-none");
                        $.confirm({
                            backgroundDismiss: false,
                            title: false,
                            content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 21px;">Searching Data... <i class="fas fa-circle-notch fa-spin"></i></label></div>',
                            buttons: false
                        });
                },
                    data: { u: url, u_id: id, mode:m},
                    success: function (response) {

                        //_divPartialView.style = "";
                        //$("#divWaiting").addClass("display-none");
                        $("#shop").html(response).removeAttr("style");

                        setTimeout(function () {
                            $(".jconfirm-closeIcon").click();

                        }, 500);

                        window.history.pushState("state", "title", url);

                        $('html, body').animate({
                            scrollTop: $("#shop").offset().top - $('#header').outerHeight()
                        }, 1000);



                       // $('#datatable1').dataTable();
                    },
                    complete: function () {

                        var int = setInterval(function () {
                            $("#shop .product, #shop .clear, #shop h5, #shop hr, #shop > div").removeAttr("style");

                            //if ($("#shop .product").attr != "style"){
                            //    clearInterval(int);
                            //}

                        }, 500);



                    }
            });
           //  return false;// if it's a link to prevent post
        }
    </script>
}
<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/loginhead2.png'); background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>@ViewBag.Title</h1>
        <span>Looking for something specific ? Search here for details.</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
        </ol>
    </div>

</section><!-- #page-title end -->
<!-- Content
        ============================================= -->
<section id="content">

    <div class="content-wrap pt-3">

        <div class="container clearfix">

            <!-- Post Content
            ============================================= -->
            <div class=" nobottommargin col_last">

                <!-- Shop
                ============================================= -->
                <div id="shop" class="shop srcresult product-4 grid-container clearfix" data-layout="fitRows">



                </div><!-- #shop end -->






            </div><!-- .postcontent end -->
        </div>


        
           @if (ViewBag.Title == "Search")
           {


               if (Model.Tables[0].Rows.Count > 0)
               {
