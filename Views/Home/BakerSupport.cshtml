                <h3>OUR SERVICES</h3>
                <hr style="margin-bottom: -10px;" />
                <hr class="hrredline" />
            </div>

            <span class="divcenter">"Share with us your baking concerns /queries so that our team of experts can guide you with the appropriate solution."</span>
        </div>
        @*<div class="heading-block mt-5  center ">
                <h3>OUR SERVICES</h3>
                <span class="divcenter">"Share with us your baking concerns /queries so that our team of experts can guide you with the appropriate solution."</span>
            </div>*@
        <div class="row" style="padding: 5% 0 20px;">
            <div class="col-lg-4 mb-md-3 mb-lg-0 Services1">
                <div class="row">
                    <div class="col-md-4 Services1-img">

                    </div>
