            <div class="col-lg-4 mb-md-3 mb-lg-0 Services3">
                <div class="row">
                    <div class="col-md-4 Services3-img">

                    </div>
                    <div class="col-md-8">
                        <h4 class="mb-1">TECHNICAL SUPPORT</h4>
                        <p>Our team of experts can to provide support to our clients in the area of baking process, equipment selection, material sourcing and product formulation in order to optimise or improver their end results.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section>
    <div class="register-divider">
        <div class="container position-relative">
            @if (Session["U_Id"] == null)
            {
                <h5>DON’T HAVE AN ACCOUNT? REGISTER NOW FOR UNRESTRICTED ACCESS.</h5><a href="/register">Create Account</a>
            }
        </div>
    </div>
</section>

<section class="about-title3">
    <div class="container">
        <div class="mt-5  center">
            <div class="heading-blockline">
                <h3>BAKER SUPPORT</h3>
                <hr style="margin-bottom: -10px;" />
                <hr class="hrredline" />
            </div>

            <span class="divcenter">Reach out to us in order to get guidance, opinions and suggestions on your baking needs and challenges from our team of technical and professional bakers</span>
        </div>
        <div class="row">
            <div class="col-xl-6">
                <div class="prod-image">
                    <img src="~/content/images/Baker_Support_Inside.png" class="img-responsive" />
                </div>
            </div>
            <div class="col-xl-6">

                <form action="" method="post">
                    <div class="row">
                        <div class="col-md-6 mt-3">
                            <div class="col-md-12">
                                <label>YOUR NAME</label>
                            </div>
                            <div class="col-md-12">
                                <input name="Name" id="Name" class="form-control" type="text" onkeypress="return charkey(this);" />
                            </div>
                        </div>
                        <div class="col-md-6 mt-3">
                            <div class="col-md-12">
                                <label>COMPANY NAME</label>
                            </div>
                            <div class="col-md-12">
                                <input name="Comp" id="Comp" class="form-control" type="text" />
                            </div>
                        </div>
                        <div class="col-md-6 pl-4 mt-3">
                            <div>
                                <div class="form-group label-floating">
                                    <label class="control-label">Country</label>
                                    <select name="Country" class="form-control" onchange="updateCountryCode()">
                                        <option selected="selected" value="17">BAHRAIN</option>
                                        <option value="229">UNITED ARAB EMIRATES</option>
                                        <option value="178">QATAR</option>
                                        <option value="965">KUWAIT</option>
                                        <option value="968">OMAN</option>
                                        <option value="966">SAUDI ARABIA</option>
                                        <option value="964">IRAQ</option>
                                        <option value="967">YEMEN</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mt-3">
                            <div class="col-md-12">
                                <label>EMAIL ID</label>
                            </div>
                            <div class="col-md-12">
                                <input name="Email" id="Email" type="email" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-12 mt-3">
                            <div class="row">
                                <div class="col-md-6 pl-4">
                                    <div class="form-group label-floating">
                                        <label class="control-label">Country Code</label>
                                        <select disabled name="BS_countryCode" id="BS_countryCode" class="form-control">
                                            <option selected="selected" value="973">+973 </option>
                                            <option value="971">+971</option>
                                            <option value="974">+974</option>
                                            <option value="965">+965</option>
                                            <option value="968">+968</option>
                                            <option value="966">+966</option>
                                            <option value="964">+964</option>
                                            <option value="967">+967</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label>CONTACT NO.</label>
                                    <input name="Cont" id="Cont" class="form-control" maxlength="8" onkeypress="return numkey(this);" />
                                </div>
                            </div>
                            <div class="col-md-12 mt-3">
                                <div class="col-md-12">
                                    <input type="radio" id="Qry-tip" ng-model="radio" name="group-radio" ng-value="1" /> <label for="Qry-tip">BAKING QUERY / TIP REQUIRED</label>
                                </div>

                            </div>
                            <div class="col-md-12 mt-3">
                                <div class="col-md-12">
                                    <input type="radio" id="Det-rec" ng-model="radio" name="group-radio" ng-value="2" /> <label for="Det-rec">PRODUCT DETAIL OR RECIPE</label>

                                </div>
                            </div>
                            <div class="col-md-12 mt-3">
                                <div class="col-md-12">
                                    <input type="radio" id="New-sol" ng-model="radio" name="group-radio" ng-value="3" /> <label for="New-sol">NEW PROJECT OR CUSTOMIZED SOLUTION</label>

                                </div>
                            </div>
                            <div class="col-md-12 mt-3" ng-show="radio == '1' || radio == '2' || radio == '3'">
                                <div class="col-md-12">
                                    <label ng-show="radio == '1'">PRODUCT BEING BAKED</label>
                                    <label ng-show="radio == '2'">SWISS BAKE PRODUCT NAME</label>
                                    <label ng-show="radio == '3'">DESCRIBE THE PROJECT OR REQUIRED SOLUTION IN DETAIL</label>
                                </div>
                                <div class="col-md-12">
                                    <textarea class="form-control" name="val1" ng-model="noofchars1" ng-trim="false" rows="4" maxlength="500"></textarea>
                                    <span>{{500 - noofchars1.length}}/500</span>
                                </div>
                            </div>
                            <div class="col-md-12 mt-3" ng-show="radio == '1' || radio == '2' || radio == '3'">
                                <div class="col-md-12">
                                    <label ng-show="radio == '1' || radio == '2'">DESCRIBE THE QUERY / REQUIREMENT IN DETAIL</label>
                                    <label ng-show="radio == '3'">ESTIMATED MONTHLY REQUIREMENT</label>
                                </div>
                                <div class="col-md-12">
                                    <textarea class="form-control" name="val2" ng-model="noofchars2" ng-trim="false" rows="4" maxlength="500"></textarea>
                                    <span>{{500 - noofchars2.length}}/500</span>
                                </div>
                            </div>
                            <div class="col-md-12 mt-3" ng-show="radio == '3'">
                                <div class="col-md-12">
                                    <label ng-show="radio == '3'">TIME DURATION FOR US TO DEVELOP THE SOLUTION</label>
                                </div>
                                <div class="col-md-12">
                                    <textarea class="form-control" name="val3" ng-model="noofchars3" ng-trim="false" rows="4" maxlength="500"></textarea>
                                    <span>{{500 - noofchars3.length}}/500</span>
                                </div>
                            </div>

                            <div class="row col-md-12 mt-3 pl-5">
                                @*<div class="col-md-7 recatpcha text-center p-xl-0">
                                        @Html.Recaptcha()
                                        @Html.ValidationMessage("ReCaptcha")

                                    </div>*@
                                <div class="col-md-5">
                                    <button type="submit" class="button mt-3 w-100 contactnbtn">SEND</button>
                                </div>
                            </div>
                            @if (ViewBag.EmailSendingSuccess != null && ViewBag.EmailSendingSuccess == false)
                            {
                                <div class="row col-md-12 mt-3 pl-5">
                                    <div class="col-md-12">
                                        <div class="text-danger">OOPS!!! There were some error while processing your requesting right now. Please try after a while.</div>
                                    </div>
                                </div>
                            }


                        </div>
                </form>

            </div>

        </div>
    </div>
</section>



