@section head{
    <link href="~/Content/css/CStyle.css" rel="stylesheet" />
    <style>
        .recatpcha {
            position: relative;
        }
        /*.g-recaptcha{
            float:right;
        }*/
        .rc-anchor-light.rc-anchor-normal {
            border: none;
            background: none;
            box-shadow: none;
        }

        .field-validation-valid {
            color: red;
            float: left;
            position: absolute;
            bottom: 5px;
            left: 15px;
        }
    </style>
}

@section foot{
    <script>
        $(document).ready(function () {
            $("#Qry-tip").click();

            // Code for the Validator
            var form = $('form');
            var error = $('.sm-form-control', form);

            $.validator.addMethod(
                "regex",
                function (value, element, regexp) {
                    var re = new RegExp(regexp);
                    return this.optional(element) || re.test(value);
                },
                "This is invalid"
            );



            var $validator = $('form').validate({
                //doNotHideMessage: true, //this option enables to show the error/success messages on tab switch.
                //errorElement: 'span', //default input error message container
                //errorClass: 'error-block1', // default input error message class
                //focusInvalid: false, // do not focus the last invalid input
                rules: {
                    Name: {
                        required: true,
                        regex: /^([a-zA-Z]+\s)*[a-zA-Z]+$/,
                    },
                    Comp: {
                        required: true,
                        regex: /^([0-9a-zA-Z]+\s)*[0-9a-zA-Z]+$/,
                    },
                    Email: {
                        required: true,
                        regex: /^[\w-\.]+@@([\w-]+\.)+[\w-]{2,4}$/
                    },
                    Country: {
                        required: true
                    },
                    Cont: {
                        required: true,
                        //regex: /([0-9]{8}$)/,

                        //minlength: 8,
                        //maxlength: 8,
                    }
                },

                messages: {
                    Name: {
                        required: "This is required",
                        regex: "This is invalid",
                    },
                    Comp: {
                        required: "This is required",
                        regex: "This is invalid",
                    },
                    Email: {
                        required: "This is required",
                        regex: "This is invalid"
                    },
                    Country: {
                        required: "This is required"
                    },
                    Cont: {
                        required: "This is required",
                        //regex: "This is invalid",

                        minlength: "This is invalid",
                        maxlength: "This is invalid",
                    }
                },

                errorPlacement: function (error, element) {
                    //if (element.attr("name") == "typeoption") { // for uniform radio buttons, insert the after the given container
                    //    error.insertAfter("#show-error");
                    //}
                    ////else if (element.attr("name") == "payment[]") { // for uniform checkboxes, insert the after the given container
                    ////    error.insertAfter("#form_payment_error");
                    ////}
                    //else {
                    //    error.insertAfter(element); // for other inputs, just perform default behavior
                    //}
                    error.insertAfter(element);
                },
                //success: function (label) {
                //    if (label.attr("for") == "typeoption") { // for checkboxes and radio buttons, no need to show OK icon
                //        label.remove(); // remove error label here
                //    }
                //},
                submitHandler: function (form) {
                    var $valid = $('form').valid();
                    var v = grecaptcha.getResponse();

                    if (!$valid) {
                        $validator.focusInvalid();

                        return false;
                    }
                    else if (v.length == 0) {
                        $(".field-validation-valid").text("Recaptcha is required");
                        //$(".rc-anchor-aria-status").css("display", "block");
                        $.confirm({
                            backgroundDismiss: true,
                            title: false,
                            content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">Captcha is Required</label></div>',
                            buttons: false
                        });
                        setTimeout(function () {
                            $('.jconfirm-closeIcon').click();
                        }, 1000);
                        return false;
                    }
                    else {
                        $(".field-validation-valid").css("display", "none");
                        form.submit()
                        //getOrder($("[name=email]").val(), $("[name=orderno]").val(), $("[name=awbno]").val(), $("#type").val())
                        return false;
                    }
                    //add here some ajax code to submit your form or just call form.submit() if you want to submit the form without ajax
                }
            });

            @Html.Raw(ViewBag.error)

        });


        function sucess() {
            $.confirm({
                backgroundDismiss: false,
                title: false,
                content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">Thankyou for contacting us.</label></div>',
                buttons: false
            });
            setTimeout(function () {
                $('.jconfirm-closeIcon').click();
            }, 5000);
        }

        //Cascading on Country with Country Code

        function updateCountryCode() {
            var countrySelect = document.getElementsByName('Country')[0];
            var countryCodeSelect = document.getElementById('BS_countryCode');
            var mobileElement = document.getElementById('Cont');
            mobileElement.setAttribute("minlength", "10")
            mobileElement.setAttribute("maxlength", "10")

            if (countrySelect.value === '17') {
                countryCodeSelect.value = '973';
                mobileElement.setAttribute("minlength", "8")
                mobileElement.setAttribute("maxlength", "8")
            } else if (countrySelect.value === '229') {
                countryCodeSelect.value = '971';
            } else if (countrySelect.value === '178') {
                countryCodeSelect.value = '974';
            } else if (countrySelect.value === '965') {
                countryCodeSelect.value = '965';
            } else if (countrySelect.value === '968') {
                countryCodeSelect.value = '968';
            } else if (countrySelect.value === '966') {
                countryCodeSelect.value = '966';
            } else if (countrySelect.value === '964') {
                countryCodeSelect.value = '964';
            } else if (countrySelect.value === '967') {
                countryCodeSelect.value = '967';
            }
        }

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fields = document.querySelectorAll("input[type='text'], input[type='email'], textarea");

            fields.forEach(field => {
                field.addEventListener("input", function () {
                    this.value = this.value.toUpperCase();
                });
            });
        });
    </script>

}

