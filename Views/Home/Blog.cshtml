@using System.Data
@model DataSet
@{
    ViewBag.Title = "Blog";

    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}


<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/loginhead2.png'); background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>BLOG ARTICLES</h1>
        <span>Articles covering bakery trends, insights, know-how and science behind baking.</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">BLOG ARTICLES</li>
        </ol>
    </div>

</section><!-- #page-title end -->


<!-- Content
    ============================================= -->
<section class="cat-grid pt-4 pb-4">
    <div class="container">
        <div class="row">
            @{ 
                var i = 1;

            }
            @foreach (DataRow row in Model.Tables[0].Rows)
            {
                string title = "";
                string img = ViewBag.Domain + "/" + Convert.ToString(row["BlogCat_imgPath"]);
                //string img = "/Content/images/sbimg/blog" + i + ".jpg";
                i++;
                var tcount = row["BlogCat_Name"].ToString().Length;
                if (tcount > 35)
                {
                    title = Convert.ToString(row["BlogCat_Name"]); //.Substring(0, 35) + "...";
					//title = title + Convert.ToString(row["BlogCat_Name"]); //.Substring(0, 35) + "...";
					title = title.Substring(0,title.IndexOf(" ", 32)) + "...";
					
                }
                else
                {
                    title = Convert.ToString(row["BlogCat_Name"]);
                }


                <div class="col-md-3 text-center">
                    <div class="cat-content">
                        @*add class new*@
                        <a href="@Url.RouteUrl("Categoryblog",new { url = row["BlogCat_Seourl"] })">
                            <img src="@img" alt="@row["BlogCat_Seotitle"]" title="@row["BlogCat_Name"]" />
                            <h4>@title</h4>
                        </a>
                    </div>
                </div>
                
            }
        </div>
    </div>
</section>




