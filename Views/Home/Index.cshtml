<header id="header" class="transparent-header" style="opacity:0;">

    <div id="header-wrap">

        <div class="container-fluid clearfix">

            <div id="primary-menu-trigger" class="op-0 animated delay-3s"><i class="icon-reorder"></i></div>

            <div id="logo" class="op-0 animated delay-3s">
                <a href="#" class="standard-logo" data-dark-logo="~/Content/images/logo/swissbake-logo.png"><img src="~/Content/images/logo/swissbake-logo.png" alt="Swissbake"></a>
                <a href="#" class="retina-logo" data-dark-logo="~/Content/images/logo/swissbake-logo.png"><img src="~/Content/images/logo/swissbake-logo.png" alt="Swissbake"></a>
            </div>
            <nav id="primary-menu" class="style-2">
                <ul class="style-2 op-0 animated delay-3s">
                    <li class="active">
                        <a href="#"><div>About</div></a>
                    </li>
                    <li>
                        <a href="#"><div>Products</div></a>
                    </li>
                    <li>
                        <a href="#"><div>Blog</div></a>
                    </li>
                    <li>
                        <a href="#"><div>Baker Tools</div></a>
                    </li>
                    <li>
                        <a href="#"><div>Global</div></a>
                    </li>
                </ul>
            </nav><!-- #primary-menu end -->

            <div class="col_one_third col_last fright nobottommargin mt-2 right-menu">


                <div class="seach-sect right-widget text-center op-0 animated delay-5s">
                    <i class="fa fa-search"></i><span>@*<small>Quantity <b>10</b></small>*@<b>Search</b></span>
                </div>
                <div id="side-panel-trigger" class="cart-sect right-widget side-panel-trigger text-center op-0 animated delay-5s">
                    <i class="fab fa-opencart"></i><span>@*<small>Quantity <b>10</b></small>*@<b>Cart</b></span>
                </div>
                <div id="side-panel-trigger" class="log-reg right-widget side-panel-trigger text-center op-0 animated delay-4s">
                    <i class="far fa-user"></i><span><b>Signin/Signup</b>@*<b>My Orders</b>*@</span>
                </div>
                <div class="country-sect right-widget text-center op-0 animated delay-5s">
                    <img src="~/Content/images/flags/Bahrain.png" /><span>@*<small>Quantity <b>10</b></small>*@<b>Region</b></span>
                </div>


            </div>


        </div>

    </div>
    <div class="search-bar">
        <input class="search" placeholder="Whats On Mind, Search Here..." />
    </div>
</header><!-- #header end -->


