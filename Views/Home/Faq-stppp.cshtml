@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
	
}


@section foot{



    <script>
        
        function togglefaq() {
            $(".togglet").click();
        }

			

        var app = angular.module('MyApp', ['ngSanitize'])

		
        app.controller('faq', function ($scope, $http, $window) {

            $http({
                method: "GET",
                url: "/FaqCat",
                dataType: 'json',
                //data: customer,
                //headers: { "Content-Type": "application/json" }
            }).then(function (response) {

                if (response.status == 200) {
                    $scope.FaqCat = response.data;
                    $scope.fqact = $scope.FaqCat[0].FAQcat_Id;
                    $scope.faqgetdet($scope.FaqCat[0].FAQcat_Id)

                }

            });

				 
            $scope.faqgetdet = function (cat) {
                var update = '{T: "'+ cat +'" }';
                $http({
                    method: "POST",
                    url: "/FaqDet",
                    dataType: 'json',
                    data: update,
                    headers: { "Content-Type": "application/json" }
                }).then(function (response) {

                    if (response.status == 200) {
                        $scope.FaqDet = response.data;
                        $scope.fqact = cat;
                        setTimeout(function () { SEMICOLON.widget.toggles(); }, 50);
                        setTimeout(function () { togglefaq(); },150)
                        
                    }

                });
            }


		$scope.convertToHTML = function(html) {
			$myval = html.replace("[BL]","<br/>");
			$scope.myHTML=" Hello <B> World </B>";
			return $myval;
		}
		

        });
		
		$(function() {
			console.log($('.htmlfaq').length);
			$('.htmlfaq').each(function () {
				var html = $(this).html();
				console.log(html);
				$(this).html('').append('<div>' + html + '</div>');
			});
		});
		
		$(document).ready(function() {
			
		});
		
</script>

}


<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/FAQ.png'); background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>FAQ’s</h1>
        <span>Here you can find answers to or request solutions for your concerns related to our company and products.</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">FAQ'S</li>
        </ol>
    </div>

</section><!-- #page-title end -->
<!-- Content
        ============================================= -->	
					
<section id="content" class="faqpage" ng-controller="faq">

    <div class="content-wrap">

        <div class="container clearfix">

            <!-- Post Content
            ============================================= -->
            <div class="postcontent nobottommargin w-lg-75 col_last">
			
					
                <div class="clear"></div>
                <div id="faqs" class="faqs">
                    <div ng-if="FaqDet.length > 0" class="toggle faq faq-marketplace faq-authors" ng-repeat="fd in FaqDet">
                        <div class="togglet">{{fd.FAQ_Quest}}</div>
						<div class="togglec htmlfaq" ng-bind-html="fd.HTMLFAQ_Ans">{{fd.HTMLFAQ_Ans}}</div>
                    </div>
					
                    <div ng-if="FaqDet.length == 0">
                        <p class="border-bottom">NO FAQ FOUND</p>
                    </div>
                    @*@foreach (DataRow i in Model.Tables[1].Rows)
                    {
                        <h4>@i["FAQcat_Name"]</h4>
                        foreach (DataRow j in Model.Tables[0].Rows)
                        {
                            if (j["FAQ_CatID"].ToString() == i["FAQcat_Id"].ToString())
                            {

                                <div class="toggle faq faq-marketplace faq-authors">
                                    <div class="togglet">@j["FAQ_Quest"]</div>
                                    <div class="togglec">@j["FAQ_Ans"].Replace("[BL]","<br/>")</div>
                                </div>
                            }
                        }
                        <hr />
                    }*@
                </div>

                <div class="mt-5"></div>
            </div><!-- .postcontent end -->
            <div class="sidebar nobottommargin norightmargin">
                <div class="sidebar-widgets-wrap">
                    <div id="cat-side" class="widget widget_links clearfix">
                        @*<h4>Shop Categories</h4>*@
                        <ul>
                            <li ng-repeat="fc in FaqCat" ng-click="faqgetdet(fc.FAQcat_Id);" ng-class="fqact == fc.FAQcat_Id ? 'active' : ''" class="cursor-pointer"><a >{{fc.FAQcat_Name}}</a></li>
                        </ul>
                    </div>
                </div>
            </div>



        </div>

    </div>

</section><!-- #content end -->
