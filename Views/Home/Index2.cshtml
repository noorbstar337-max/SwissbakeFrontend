@section  foot{

@Scripts.Render("~/bundles/Rev")
    <script src="~/Content/js/custom1.js"></script>
<script>
            var tpj=jQuery;
            var revapi116;
            tpj(document).ready(function() {
                if(tpj("#rev_slider_116_1").revolution == undefined){
                    revslider_showDoubleJqueryError("#rev_slider_116_1");
                }else{
                    revapi116 = tpj("#rev_slider_116_1").show().revolution({
                        sliderType:"standard",
                        jsFileLocation:"~/Content/include/rs-plugin/js/",
                        sliderLayout:"auto",
                        dottedOverlay:"none",
                        delay:9000,
                        navigation: {
                            keyboardNavigation:"off",
                            keyboard_direction: "horizontal",
                            mouseScrollNavigation:"off",
                            onHoverStop:"off",
                            touch:{
                                touchenabled:"on",
                                swipe_threshold: 75,
                                swipe_min_touches: 1,
                                swipe_direction: "horizontal",
                                drag_block_vertical: false
                            }
                            ,
                            arrows: {
                                style:"gyges",
                                enable:true,
                                hide_onmobile:true,
                                hide_under:600,
                                hide_onleave:true,
                                hide_delay:200,
                                hide_delay_mobile:1200,
                                tmp:'',
                                left: {
                                    h_align:"left",
                                    v_align:"center",
                                    h_offset:30,
                                    v_offset:0
                                },
                                right: {
                                    h_align:"right",
                                    v_align:"center",
                                    h_offset:30,
                                    v_offset:0
                                }
                            }
                        },
                        viewPort: {
                            enable:true,
                            outof:"pause",
                            visible_area:"100%"
                        },
                        gridwidth:1240,
                        gridheight:600,
                        lazyType:"none",
                        shadow:0,
                        spinner:"off",
                        stopLoop:"off",
                        stopAfterLoops:-1,
                        stopAtSlide:-1,
                        shuffle:"off",
                        autoHeight:"on",
                        hideThumbsOnMobile:"off",
                        hideSliderAtLimit:0,
                        hideCaptionAtLimit:0,
                        hideAllCaptionAtLilmit:0,
                        debugMode:false,
                        fallbacks: {
                            simplifyAll:"off",
                            nextSlideOnWindowFocus:"off",
                            disableFocusListener:false,
                        }
                    });
                }
            });	/*ready*/
    </script>

}


