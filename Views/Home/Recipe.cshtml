@using System.Data
@model DataSet
@{
    ViewBag.Title = "Recipe";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}

@section head{

    <style>
        .blog-card{
            height:350px !important;
        }

            .blog-card .product {
                transition-property: none !important;
                transition-duration: 0s !important;
                transition-delay: 0ms !important;
                transform: translate3d(0px,0px,0px) !important;
            }

        @@media (max-width: 767px) {
            .post-grid .entry, .post-masonry-full.grid-3 .entry {
                float: left !important;
            }
        }
    </style>


}


@section seo{
    <meta http-equiv="Last-Modified" content="4/23/2019 7:30:06 AM" />
    <meta property="og:title" content="Recipe | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta name="Title" content="Recipe | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta name="description" content="Know how you can use our products to amplify your baking possibilities." />
    <meta name="keywords" content="Know how you can use our products to amplify your baking possibilities." />
    <meta property="og:description" content="Know how you can use our products to amplify your baking possibilities." />
    <meta property="og:url" content="http://uat.swissbake.bh/recipe" />
    <meta property="twitter:title" content="Recipe | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta property="twitter:description" content="Know how you can use our products to amplify your baking possibilities." />
    <meta property="og:image" content="http://uat.swissbake.bh" />
    <link rel="canonical" href="http://uat.swissbake.bh/recipe" />
}

@section foot{
<script src="~/Content/js/bind/recipe.js"></script>
}


<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/header/Recipe.jpg');background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>BAKER RECIPE</h1>
        <span>Knowledge base of baker recipes created by our baking experts to amplify your baking possibilities.</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recipe</li>
        </ol>
    </div>

</section><!-- #page-title end -->
