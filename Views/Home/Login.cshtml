                </div>*@
                                </form>

                            </div>
                            <div class="col-lg-6 pl-lg-0 log-side-info">
                                <div class="row ml-3 ">
                                    <div class="col-md-12 mt-3 pt-2 pl-0 pr-5">
                                        <h3>Create an account with us and you’ll be able to do:</h3>
                                        <ul class="list-unstyled ml-2 mt-2" style="">
                                            <li>•	Real time order tracking </li>
                                            <li>•	Easy product sample ordering </li>
                                            <li>•	Calculate your food cost & yield</li>
                                            <li>•	Multiple payment options</li>
                                        </ul>
                                        <a href="/register" class="btn btn-danger">Create Account</a>
                                    </div>
                                    
                                </div>
                            </div>
                            
                        </div>
                        
                    </div>
                </div> <!-- wizard container -->
            </div>
        </div><!-- end row -->
    </div> <!--  big container -->

</section>
    
