<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/loginhead2.png'); background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>SIGN IN </h1>
        <span>Your access to high quality baking ingredients from SwissBake® </span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">SIGN IN </li>
        </ol>
    </div>

</section>
<!-- #page-title end -->

<section class="login" style="">

    <div class="container">
        <div class="row">
            
            <div class="col-md-10 m-auto">
                <!--      Wizard container        -->
                <div class="wizard-container">
                    <div class="card p-0 log-card" data-color="red">
                        <div class="row">
                            <div class="col-lg-6 shad pt-3 mt-3">
                                <form action="" method="post" class="mb-0 pl-4">
                                    <!--        You can switch " data-color="purple" "  with one of the next bright colors: "green", "orange", "red", "blue"       -->


                                    <div class="tab-pane" id="about">
                                        <div class="row m-0">
                                            <h4 class="info-text w-100 text-center pr-4">New to SwissBake?<br/> <a href="/register" class="text-danger">Register Now</a></h4>
                                            <div class="col-sm-12 mb-3">
                                                <div class="row w-100 m-0">
                                                    <div class="input-group col-sm-12 mt-4 mb-4">
                                                        <span class="input-group-addon">
                                                            <i class="material-icons"></i>
                                                        </span>
                                                        <div class="form-group label-floating ml-md-4 ml-lg-0" style="width: 75%;">
                                                            <label class="control-label">Email </label>
                                                            <input name="Email" tabindex="1" type="text" class="form-control">
                                                        </div>
                                                    </div>
                                                    <div class="input-group col-sm-12">
                                                        <span class="input-group-addon">
                                                            <i class="material-icons"></i>
                                                        </span>
                                                        <div class="form-group label-floating ml-md-4 ml-lg-0" style="width: 75%;">
                                                            <label class="control-label">Password</label>
                                                            <input id="pass" name="pswd" tabindex="2" type="password" class="form-control error" aria-required="true" aria-invalid="true">
                                                            <label id="password-error" class="error" for="password"></label>
                                                        </div>
                                                    </div>
                                                    <div class="footer-checkbox input-group col-md-12   col-xl-6 loginrem ">
                                                        <div class="col-sm-12 pt-3">
                                                            <div class="checkbox">
                                                                <label>
                                                                    <input type="checkbox" name="rememberme" tabindex="3">
                                                                </label>
                                                                Remember Me
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-3 offset-xl-1  input-group loginbtn ">
                                                        <input type="text" name="mode" value="login" class="d-none" />
                                                        <input type="submit" name="login" class="btn btn-success m-auto" value="Login" />
                                                    </div>
                                                    <div class="col-xl-11 mt-2 pr-2">
                                                        <div class="text-center text-xl-right">
                                                            <a id="forgot" class="text-danger cursor-pointer mr-lg-3">Forgot Password?</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @*<div class="wizard-footer">
                    <div class="pull-right">
                        <input type='button' class='btn btn-next btn-fill btn-success btn-wd' name='next' value='Next' />
                        <input type='submit' class='btn btn-finish btn-fill btn-success btn-wd' name='finish' value='Finish' />
                    </div>
