    <script>
        $(document).ready(function () {
            var s = 10;
            var returnUrl = localStorage.getItem("returnPage") || "/"; // Default to home if not found

            var timer = setInterval(function () {
                $("#secs").html(s);
                if (s == 0) {
                    localStorage.removeItem("returnPage");
                    window.location.href = returnUrl;
                    clearInterval(timer);
                }
                s--;
            }, 1000);
        });
    </script>


}

