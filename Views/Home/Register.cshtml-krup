}
@section head{
    @*<link href="~/Content/css/bootstrap.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" />
    <link href="~/Content/css/material-bootstrap-wizard.css" rel="stylesheet" />
    <!-- CSS Just for demo purpose, don't include it in your project -->
    <link href="~/Content/css/demo.css" rel="stylesheet" />
    <style>
        label.error {
            font-size: 8px !important;
            color: #da0003 !important;
        }

        .registerfrm .shad {
            /*box-shadow: 30px 0px 40px -50px #000*/
        }

        .reg-side-info {
            background: url('/Content/images/sbimg/bckimg.png');
            background-size: 50%;
            background-repeat: repeat
        }

            .reg-side-info ul {
                font-size: 1.3rem;
                line-height: 3;
            }

        @@media screen and (max-width:991px) {
            .registerfrm .shad {
                /*box-shadow: 0px 30px 40px -50px #000;*/
                /*padding-bottom: 30px;*/
            }
        }
    </style>

}

@section foot{
    <!--   Core JS Files   -->
    @*<script src="~/Content/js/register/jquery-2.2.4.min.js" type="text/javascript"></script>*@
    <script src="~/Content/js/register/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/Content/js/register/jquery.bootstrap.js" type="text/javascript"></script>
    @*<script src="~/Content/js/angular.min.js"></script>*@
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.7.5/angular-route.min.js"></script>*@
    <!--  Plugin for the Wizard -->
    <script src="~/Content/js/register/material-bootstrap-wizard.js"></script>
    <!--  More information about jquery.validate here: http://jqueryvalidation.org/	 -->
    <script src="~/Content/js/register/jquery.validate.min.js"></script>
    <script>
        var app = angular.module('MyApp', ['ngRoute']);
        app.billing = true;
        function updateMobileNumerLength() {
            var mobileElement = document.getElementById("mobile2")
            var countryDropDown = document.getElementById("countryDropDown")
            if (countryDropDown.value == '17') {
                mobileElement.setAttribute("minlength", "8")
                mobileElement.setAttribute("maxlength", "8")
            }
            else {
                mobileElement.setAttribute("minlength", "10")
                mobileElement.setAttribute("maxlength", "10")
            }
        }

        $(document).ready(function () {
            $(".registerfrm input").keyup(function () {
                var val = $(this).val();
                if (val && val != "" && $(this).attr("type") != 'password' && $(this).attr("name") != "emailid") {
                    val = val.toUpperCase();
                }
                $(this).val(val);

            })
            $(".hdn-same-billing").hide();
            $(".chkSameBilling").change(function () {
                if ($(this).is(":checked")) {
                    $(".hdn-same-billing").hide();
                } else {
                    $(".hdn-same-billing").show();
                }
            })

            $(".CRNO1AVAILBLE").change(function () {
                var val = $(this).val();
                if (val == "0") {
                    $(".crnumber1txt").css("visibility", "hidden");
                    $("#CrNoVerificationMsg").show();

                } else {
                    $(".crnumber1txt").css("visibility", "visible");
                    $("#CrNoVerificationMsg").hide();

                }
            })
        })
        //Cascading on Country with Country Code

        function updateCountryCode() {
            var countrySelect = document.getElementsByName('BI_country')[0];
            var countryCodeSelect = document.getElementById('BI_countryCode');
            var mobileElement = document.getElementById('mobile')
            mobileElement.setAttribute("minlength", "10")
            mobileElement.setAttribute("maxlength", "10")

            if (countrySelect.value === '17') {
                countryCodeSelect.value = '973';
                mobileElement.setAttribute("minlength", "8")
                mobileElement.setAttribute("maxlength", "8")
            } else if (countrySelect.value === '229') {
                countryCodeSelect.value = '971';
            } else if (countrySelect.value === '178') {
                countryCodeSelect.value = '974';
            } else if (countrySelect.value === '965') {
                countryCodeSelect.value = '965';
            } else if (countrySelect.value === '968') {
                countryCodeSelect.value = '968';
            } else if (countrySelect.value === '966') {
                countryCodeSelect.value = '966';
            } else if (countrySelect.value === '964') {
                countryCodeSelect.value = '964';
            } else if (countrySelect.value === '967') {
                countryCodeSelect.value = '967';
            }
        }
    </script>
    @Html.Raw(ViewBag.script)
}

<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/loginhead2.png'); background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>ACCOUNT REGISTRATION</h1>
        <span>Create a FREE account on our website. </span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">ACCOUNT REGISTRATION </li>
        </ol>
    </div>

</section>
<!-- #page-title end -->
@*<section class="registerfrm" style="background: url('/Content/images/others/bg_heading.jpg');background-attachment: fixed;background-position: 50% -30%;background-repeat: no-repeat;background-size: cover;">*@
<section class="registerfrm">
    <div class="container">
        <div class="row">

            <div class="col-sm-10 m-auto">
                <!--      Wizard container        -->
                <div class="wizard-container">

                    <div class="card wizard-card" data-color="red" id="wizardProfile">

                        <div class="row">

                            <div class="col-lg-12 shad">

                                <form action="" method="">
                                    <input type="text" name="hfid" style="display:none;" value="@ViewBag.hfid" />
                                    <input type="text" id="Step" style="display:none" value="@ViewBag.step" />
                                    <!--        You can switch " data-color="purple" "  with one of the next bright colors: "green", "orange", "red", "blue"       -->
                                    <h4 class="info-text w-100">ALREADY HAVE AN ACCOUNT? <a href="/login" class="text-danger">Login Now</a></h4>
                                    <div class="wizard-navigation d-none">
                                        <ul>
                                            <li><a href="#about" data-toggle="tab">Business Information </a></li>
                                            <li><a href="#account" data-toggle="tab">Account Type</a></li>
                                            <li><a href="#address" data-toggle="tab">Address Information</a></li>
                                        </ul>
                                    </div>
                                    <div class="nav-bar">
                                        <b id="reg-title"></b>
                                    </div>
                                    <div class="tab-content">
                                        <div class="tab-pane" id="about">
