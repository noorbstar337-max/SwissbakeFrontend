                                                        <input type="text" name="ShippingName" value="@ViewBag.CompName{{companyname}}" class="form-control nocpc" onkeypress="return charkey(this);">
                                                    </div>
                                                </div>
                                                <div class="col-sm-4 mb-2 col-sm-offset-1 hdn-same-billing">
