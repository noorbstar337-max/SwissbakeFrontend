                                                        <label class="control-label">Telephone</label>
                                                        <input type="text" name="Mobile2" maxlength="8" class="form-control nocpc" onkeypress="return numkey(this);">
                                                    </div>
                                                </div>
                                                <div class="col-sm-10 mb-2 hdn-same-billing">
