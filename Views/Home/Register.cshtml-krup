@{
    ViewBag.Title = "Register | Bakery Ingredients Supplier - Swissbake";
    ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
}

@section seo{
    <meta http-equiv="Last-Modified" content="4/23/2019 7:30:06 AM" />
    <meta property="og:title" content="Register | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta name="Title" content="Register | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta name="description" content="Register" />
    <meta name="keywords" content="Register" />
    <meta property="og:description" content="Register" />
    <meta property="og:url" content="http://swissbake.bh/register" />
    <meta property="twitter:title" content="Register | Bakery Ingredients Supplier in Bahrain - Swissbake" />
    <meta property="twitter:description" content="Register" />
    <meta property="og:image" content="http://swissbake.bh/Content/images/logo/Swissbake-logo.png" />
