<section id="page-title" class="pt-11" style="background: url('/Content/images/sbimg/contact.png');background-size: 100%; background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>Export</h1>
        <span>Have any Questions? Here’s how you can get in touch with us. </span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Export</li>
        </ol>
    </div>

</section><!-- #page-title end -->


<section>
    <div class="container">
        <h3 class="about-heading">
            The service of this website is not available in your region. Please provide us with your valuable details so that our business development team can get in touch with you and discuss in brief regarding your requirements.
        </h3>
    </div>
</section>

<section>
    <div class="container">
        <div class="heading-block topmargin-lg center ">
            <h3>SEND US A MESSAGE</h3>
        </div>
        <div class="row cont-form">
            <div class="col-lg-8 offset-lg-2">


                <div class="">
                    @using (Html.BeginForm("Export","Home"))
                    {
                        <div class="row">
                            <div class="col_one_third">
                                <input type="text" id="Organisation" name="Organisation" value="" class="sm-form-control" placeholder="Organisation"  onkeypress="return charkey(this);"/>
                                
                            </div>
                            <div class="col_one_third ">
                                <select class="sm-form-control" name="Type">
                                    <option value="">-- Select Type --</option>
                                    <option value="Supplier">Supplier</option>
                                    <option value="End User">End User</option>
                                </select>
                                
                                
                            </div>
                            <div class="col_one_third col_last">
                                <input type="text" id="Turnover" name="Turnover" value="" class="sm-form-control nocpc" placeholder="Turnover ($)" onkeypress="return numkey(this);" />
                            </div>
                        </div>
                        <div class="row">
                            
                            <div class="col_half">
                                <input type="text" id="Name" name="Name" value="" class="sm-form-control nocpc" placeholder="Name" onkeypress="return charkey(this);" />
                            </div>
                            <div class="col_half col_last">
                                <input type="text" id="Designation" name="Designation" value="" class="sm-form-control nocpc" placeholder="Designation" onkeypress="return charkey(this);" />
                            </div>
                            <div class="col_full">
                                <textarea class="sm-form-control" id="InterestFor" name="InterestFor" rows="6" cols="30" placeholder="Interest For" (keypress)="omit_special_char($event)"></textarea>
                                @*onclick= "getText()"*@
                            </div>
                            
                        </div>
                        <div class="row">
                            <div class="col_one_third">
                                <input type="email" id="Email" name="Email" value="" class="sm-form-control nocpc" placeholder="Email Id" />
                                <input type="email" id="pEmail" name="pEmail" value="" class="sm-form-control nocpc" placeholder="Email Id" hidden/>
                            </div>
                            <div class="col_one_third">
                                <input type="text" id="Mobile" name="Mobile" value="" class="sm-form-control nocpc" placeholder="Mobile" maxlength="14" onkeypress="return numkey(this);" />
                            </div>
                            <div class="col_one_third col_last">
                                @Html.DropDownList("country", (SelectList)ViewBag.cntrylist, new { @class = "sm-form-control"})
                                @*<input type="text" id="State" name="State" value="" class="sm-form-control" placeholder="State" />*@
                            </div>
                            
                            
                        </div>
                        <div class="row">
                            <div class="col_half ">
                                <input type="text" id="City" name="City" value="" class="sm-form-control nocpc" placeholder="City" onkeypress="return charkey(this);" />
                            </div>
                            <div class="col_half col_last">
                                <input type="text" id="Pin" name="Pin" value="" class="sm-form-control nocpc" placeholder="Zip/Pin Code" maxlength="6" onkeypress="return numkey(this);" />
                            </div>
                            
                        </div>
                        <div class="row">
                            <div class="col_full">
                                <textarea class="sm-form-control" id="Comment" name="Comment" rows="6" cols="30" placeholder="Message"></textarea>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-7 p-xl-0">
                                @*@Html.Recaptcha()
                                @Html.ValidationMessage("ReCaptcha")*@

                                @*<div class="captcha">

                                        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
