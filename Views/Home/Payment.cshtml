            //        var id1 = 'ContentPlaceHolder1_grditemproduct_txtquantity_' + row;
            //        calculateFinalPrice1(id1, 'hfkg');

            //    }
            //}

            //-----------------------------------
            var Grid_Table = document.getElementById('tblinvoice');//document.getElementsByClassName("mT")[0].rows;//document.getElementById('<%= GridView1.ClientID%>');
            if (Grid_Table != null) {
                var pay = 0.0;
                // var grdcellcount = $('.mT>tbody>tr>td').length - 1;
                for (var row = 0; row < Grid_Table.rows.length - 1; row++) {
                    pay = pay + parseFloat(Grid_Table.rows[row + 1].cells[6].textContent.split("(")[0].replace(/[^0-9.]/g, ""));

                }

                $('.totalpay').text(Math.round(pay).toFixed(2));


            }
            var Grid_Table = document.getElementById('tblorder');//document.getElementById('<%= GridOrderPay.ClientID%>');
