@using System.Data;
@using SwissbakeIn.App_Start;
@model DataSet
@{    string imageBasePath = "https://b2b.swissbake.bh/";

    ViewBag.Title = Model.Tables[0].Rows[0]["Product_Seotitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = "http://localhost:56361";
    }
    else
    {
        //ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
        ViewBag.Domain = "https://b2b.swissbake.bh/";
    }
    string pdfurl = "";
    if (Model.Tables[0].Rows[0]["Product_Recipes"] != null && !string.IsNullOrEmpty(Model.Tables[0].Rows[0]["Product_Recipes"].ToString()))
    {
        pdfurl = Model.Tables[0].Rows[0]["Product_Recipes"].ToString();
        var parts = pdfurl.Split('/');
        if (parts.Length > 0 && parts[0] == "ipes")
        {
            parts[0] = "Recipes";
        }
        pdfurl = string.Join("/", parts);
    }
    string quotePdfurl = "";
    if (Model.Tables[0].Rows[0]["Product_Msdc"] != null && !string.IsNullOrEmpty(Model.Tables[0].Rows[0]["Product_Msdc"].ToString()))
    {
        quotePdfurl = Model.Tables[0].Rows[0]["Product_Msdc"].ToString();
        var parts = quotePdfurl.Split('/');
        if (parts.Length > 0 && parts[0] == "_MSDC")
        {
            parts[0] = "PDS_MSDC";
        }
        quotePdfurl = string.Join("/", parts);
    }
}

