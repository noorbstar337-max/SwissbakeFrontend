                    doc.write($(printContents).html());
                    doc.close();
                }
            });


            @Html.Raw(ViewBag.error)

            var thcount = $(".cart_tbl thead th").length;

            var styl = "<style>"

            for (var i = 2; i < thcount+1; i++){
                var th = $(".cart_tbl thead th:nth-child(" + i + ")").text();
                if (th != ''){
                    styl = styl + ".cart_tbl tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl+"</style>");





        });

        function sucess() {
            $.confirm({
                backgroundDismiss: false,
                title: false,
                content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">We have received your request, we will get back to you soon.</label></div>',
                buttons: false
            });
            setTimeout(function () {
                $('.jconfirm-closeIcon').click();
            }, 5000);
        }


