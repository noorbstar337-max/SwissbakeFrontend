@using System.Data;
@using SwissbakeIn.App_Start;
@model DataSet
@{
    ViewBag.Title = "Cart";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}
@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.2.3/css/responsive.dataTables.min.css" rel="stylesheet" />
    <style>
        .jconfirm .jconfirm-box div.jconfirm-content-pane {
            margin-bottom: 0;
        }

        .jconfirm .jconfirm-box .jconfirm-buttons button {
            border-radius: 0px;
        }
        /*.jconfirm-closeIcon {
            display: none !important;
        } cart pan - VAT popup close icon  */

        label.error {
            font-size: 10px;
        }

        .cart_tbl tbody td:nth-child(6):before {
            line-height: 2.7;
        }


        @@media screen and (max-width:660px) {
            #btn-Credit {
                width: 100%;
                margin: 0 0 2rem 0;
            }

            .checkoutbtn {
                width: 100%;
            }
        }
    </style>
    <style>
        /* For Firefox */
        input[type='number'] {
            -moz-appearance: textfield;
        }
        /* Webkit browsers like Safari and Chrome */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }




        @@media screen and (max-width:640px) {
            .table-responsive tbody tr td {
                padding-left: 100px !important;
            }

            .cart_tbl tbody td:nth-child(1):before {
                content: '\01F69A';
                color: red;
                filter: grayscale(1);
            }
        }
    </style>
}

