                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>




        <div class="modal fade" id="addresspopupmodel" role="dialog" ng-controller="shippaddr">
            <div class="modal-dialog model-lg">

                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="modal-title">Address</span>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>

                    <div class="modal-body">
                        <div ng-show="IsVisible">
                            <span class="btn btn-info addnewbtn mb-3 ml-3" data-toggle="modal" data-target="#addnewaddrpopup" ng-click="ShowHide()">+ Add New Address</span>
                            <div class="row">
                                <div class="col-md-6" ng-repeat="A in Address">
                                    <div class="card events-meta">
                                        <div class="card-body">
                                            <label>
                                                <span class="addrediticons">
                                                    <i class="fas fa-pencil-alt" style="color:  #2d98f3" ng-click="editAdd(A.Id)"></i>
                                                    @*<i class="fas fa-trash-alt" style="color: #d70002;"></i>*@
                                                </span>
                                                <ul class="portfolio-meta nobottommargin">
                                                    <li class="w-75 font-weight-bold">
                                                        {{A.CompName}}
                                                    </li>
                                                    <li>
                                                        {{A.Address}},{{A.City}}-{{A.Pin}}.
                                                    </li>
                                                    <li>{{A.Country}}</li>
                                                    <li>{{A.Telephone}}</li>
                                                    <li>{{A.Gst}}</li>
                                                </ul>

                                                <span class="deladdr" ng-if="selecteid==A.Id" data-dismiss="modal">
                                                    <strong>Selected Delivery Address</strong>
                                                </span>

                                                <span class="deladdr" ng-if="selecteid!=A.Id" ng-click="selectAdd(A.Id)">
                                                    <strong>Delivery on this Address</strong>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="secondaddrpopup mt-3" ng-show="IsHidden">
                            <div class="mb-3">
                                <span class="modal-title" style="color: #d70002;">Add New Address</span>
                            </div>
                            <form id="billing-shipping-form" name="billing-shipping-form" class="nobottommargin" method="POST" ng-init="CId=@Session["U_Id"].ToString()">
                                <div class="mb-3">
                                    <button type="reset" class="btn btn-primary cancelbtn" ng-click="ShowHide()">Cancel</button>
                                </div>
                                <input type="text" class="d-none" ng-model="mode" />
                                <input type="text" class="d-none" ng-model="add.Id" />
                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        <label for="shipping-form-Name">Shipping Name:</label>
                                        <input type="text" id="Name" name="Name" ng-model="add.CompName" class="sm-form-control" />
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label for="shipping-form-email">Email Address:</label>
                                        <input type="email" id="Email" name="Email" ng-model="add.Email" class="sm-form-control" />
                                    </div>
                                    <div class="form-group col-md-4">
                                        
                                        <label for="shipping-form-phone">Mobile:</label>
                                        <select name="BI_countryCode" id="BI_countryCode" class="custom-select" width="25%" style="float:left;">
                                            <option selected="selected" value="973">+973 </option>
                                            <option value="971">+971</option>
                                            <option value="974">+974</option>
                                            <option value="965">+965</option>
                                            <option value="968">+968</option>
                                            <option value="966">+966</option>
                                            <option value="964">+964</option>
                                            <option value="967">+967</option>
                                        </select>
                                        <input type="text" id="Tele" maxlength="10" name="Tele" width="70%" style="float:right;" ng-model="add.Telephone" class="sm-form-control" onkeypress="return numkey(this);" />
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label for="shipping-form-street">Address:</label>
                                        <input type="text" id="Address" name="Address" ng-model="add.Address" class="sm-form-control" />
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label for="shipping-form-pin">Pin Code:</label>
                                        <input type="text" id="Pin" name="Pin" ng-model="add.Pin" class="sm-form-control" />
                                    </div>
                                </div>


                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        <label for="shipping-form-city">City / Town:</label>
                                        <input type="text" id="City" name="City" ng-model="add.City" class="sm-form-control" />
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label for="shipping-form-country">Country:</label>
                                        @Html.DropDownList("country", (SelectList)ViewBag.cntrylist, new { @class = "sm-form-control", @disabled = "disabled" })
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label for="shipping-form-gst">VAT No:</label>
                                        <input type="text" id="Gst" name="Gst" ng-model="add.Gst" class="sm-form-control" />
                                    </div>
                                </div>

                                <div style="float: right">
                                    <button class="btn btn-primary savebtn">Save</button>
                                </div>
                            </form>
                        </div>


                    </div>
                </div>

            </div>
        </div>

    }

</section><!-- #content end -->