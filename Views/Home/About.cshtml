<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11" style="background: url('/Content/images/header/About.jpg'); background-repeat: no-repeat; background-position: bottom;">

    <div class="container clearfix">
        <h1>About Us</h1>
        <span>We provide bakers with innovative solutions to improve the quality and output of their baked products.</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">About Us</li>
        </ol>
    </div>

</section><!-- #page-title end -->

<section class="about-title1 pb-5">
    <div class="container">
        <div class="mt-4  center ">
            <div class="heading-blockline">
                <h3>WHY CHOOSE US</h3>
                <hr style="margin-bottom: -10px;" />
                <hr class="hrredline" />
            </div>
            <span class="divcenter">Finest Swiss formulated bakery ingredients and convenience products</span>
        </div>
        <div class="row">

            <div class="col-md-6 abtsec1">
                <div class="prod-image">
                    <img src="~/Content/images/others/About_Us_Who_We_Are.png" class="img-responsive" />
                </div>
            </div>
            <div class="col-md-6  pt-5">
                <div class="title-sub media-text text-justify">

                    <p>SwissBake® is a brand of premium quality Swiss-formulated bakery ingredients and convenience products.</p>

                    <p>Taucher Schweiz WLL handles the marketing and distribution of SwissBake® products within Bahrain and other GCC countries.</p>

                    <p>Our focus is on developing and marketing bakery ingredients and convenient products across Middle East and Africa.</p>

                    <p>With a state-of-the-art research facility located in Switzerland; SwissBake® is rightly placed to fulfil the evolving needs of the bakery industry and develop innovative tailor-made bakery solutions with hi-quality ingredients for bakers across the Middle East.</p>

                    <p>Swiss bake’s team of experienced cereal scientists, food technologists and baking experts have spent years in researching and developing bakery products to suit the evolving needs of the bakery industry. Our technical expertise in recipe formulation has been pivotal in developing SwissBake’s range of fine bakery ingredients.</p>

                </div>
            </div>
        </div>
    </div>
</section>


<section class="about-title2 bg-light pt-5 pb-5">
    <div class="container pt-3">
        <div class="row">
            <div class="col-md-6">
                <div class="VM VM-Box">
                    <div class="VM-icon vission">
                        <i class="far fa-eye"></i>
                    </div>
                    <div class="features title-sub">
                        <h3 class="text-center vis"><strong>OUR VISION</strong></h3>
                        <p class="text-center">“To be a global leader in developing, producing and supplying bakery ingredients & convenience products.”</p>
                        @*<ul class="pointers">
                                <li><p>Over 3 decades of serving bakery industry</p></li>
                                <li><p>In-depth understanding of bakery supply chain</p></li>
                            </ul>*@
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="VM VM-Box1">
                    <div class="VM-icon mission">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="features title-sub">
                        <h3 class="text-center mis"><strong>OUR MISSION</strong></h3>
                        <p class="text-center">“To provide authentic, natural and healthy baking solutions and convenience products to bakers around the globe.”</p>
                        @*<ul class="pointers">
                                <li><p>Swiss formulation and technical knowhow</p></li>
                                <li><p>Backward integration into material sourcing</p></li>
                            </ul>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section>
    <div class="register-divider">
        <div class="container position-relative">
            @if (Session["U_Id"] == null)
            {
                <h5>DON’T HAVE AN ACCOUNT? REGISTER NOW FOR UNRESTRICTED ACCESS.</h5><a href="/register">Create Account</a>
            }
        </div>
    </div>
</section>

