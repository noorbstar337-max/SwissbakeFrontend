                                                        <div class="grid-1-line-desc"><span>@onelinedesc</span></div>
                                                        <div class="product-price">
                                                            @if (Session["U_Id"] == null)
                                                            {
                                                                <a href="/login" class="lg-fr-prcng">Login for pricing</a>

                                                            }
