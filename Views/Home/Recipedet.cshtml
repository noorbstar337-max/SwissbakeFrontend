@*<!-- Page Title
        ============================================= -->
<section id="page-title" class="pt-11">

    <div class="container clearfix">
        <h1>Recipe Detail</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recipe Detail</li>
        </ol>
    </div>

</section><!-- #page-title end -->*@
<section  class="recipe pt-11 pb-4">
    <div id="recdet" class="container">
        <div class="detail-title-blk">
            <h1>@Model.Tables[0].Rows[0]["Recipe_Name"].ToString()</h1>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/recipe">Recipe</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Tables[0].Rows[0]["Recipe_Name"].ToString()</li>
            </ol>
        </div>
        <hr />
        <div class="row">
            
            <div class="col-lg-6">
                <img src="@img" />
            </div>
            <div class="col-lg-6 side-info-blk ">
                <div class="row bg-light mb-3 border-light-gray">
                    <div class="col-md-6 rec-det-info">
                        <span>Posted Date : @Convert.ToDateTime(Model.Tables[0].Rows[0]["Recipe_CreatedDate"]).ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="@(Session["U_Id"] != null ? "btns col-md-6 pb-2 text-right" : "btns col-md-5 offset-md-1 offset-xl-1 pt-1 text-right")">
                        @if (Session["U_Id"] != null || Model.Tables.Count > 2)
                        {
                            if (Model.Tables[2].Rows[0]["view"].ToString() == "show")
                            {

                                <a class="cursor-pointer svr" id="@Model.Tables[0].Rows[0]["Recipe_Id"]" onclick="saverecipe(this)" data-toggle="tooltip" data-placement="top" title="" data-original-title="Save Recipe">
                                    <i class="fas fa-save"></i>
                                </a>
                            }
                        }
                        
                        @*<a class="cursor-pointer" id="print" onclick="javascript:DownloadAsImage()" data-toggle="tooltip" data-placement="top" title="" data-original-title="Print Recipe">
                            <i class="fas fa-print"></i>
                        </a>*@
                        <a onclick="javascript:window.open('https://www.facebook.com/sharer.php?u=@Request.Url', '_blank', 'width=400,height=500');void(0);" class="cursor-pointer" data-toggle="tooltip" data-placement="top" title="" data-original-title="Share on Facebook">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a onclick="javascript:window.open('https://twitter.com/share?url=@Request.Url&text=@Model.Tables[0].Rows[0]["Recipe_Name"].ToString()&hashtags=Swissbake', '_blank', 'width=400,height=500');void(0);" class="cursor-pointer" data-toggle="tooltip" data-placement="top" title="" data-original-title="Share on Twitter">
                            <i class="fab fa-twitter-square"></i>
                        </a>
                        <a onclick="javascript:window.open('https://wa.me/?text=@Model.Tables[0].Rows[0]["Recipe_Name"].ToString() \r\n\r\n @Request.Url', '_blank', 'width=400,height=500');void(0);" class="cursor-pointer" data-toggle="tooltip" data-placement="top" title="" data-original-title="Share on Whatsapp">
                            <i class="fab fa-whatsapp-square"></i>
                        </a>
                    </div>
                </div>
                <span>@Model.Tables[0].Rows[0]["Recipe_Seodesc"].ToString()</span>
                <div class="row">
                    <div class="col-md-6 mt-3 mb-lg-3">
                        <img class="mr-3" width="50" src="~/Content/images/icons/img5.png" /> <strong>BAKE TEMP : </strong><span>@Model.Tables[0].Rows[0]["Recipe_BakingTemp"].ToString()</span>
                    </div>
                    <div class="col-md-6 mt-lg-3 mt-md-3 mb-lg-3">
                        <img class="mr-3" width="50" src="~/Content/images/icons/img3.png" /><strong>MIXING TIME : </strong><span> @Model.Tables[0].Rows[0]["Recipe_TotalTime"].ToString()</span>
                    </div>
                    <div class="col-md-6 mt-sm-3">
                        <img class="mr-3" width="50" src="~/Content/images/icons/img2.png" /> <strong>BAKE TIME : </strong><span>@Model.Tables[0].Rows[0]["Recipe_BakingTime"].ToString()</span>
                    </div>
                    <div class="col-md-6 mt-sm-3">
                        @*<img class="mr-3" width="50" src="~/Content/images/icons/img4.png" /><strong>PREPARATION TIME : </strong><span> @Model.Tables[0].Rows[0]["Recipe_PrepTime"].ToString()</span>*@
                        <img class="mr-3" width="50" src="~/Content/images/icons/img4.png" /><strong>PREP TIME : </strong><span> @Model.Tables[0].Rows[0]["Recipe_PrepTime"].ToString()</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mt-5 pl-4 pr-4 pt-3 pb-3 bg-light border-light-gray bottom-ing-blk">
                <h4>Ingredients</h4>
                @Html.Raw(Model.Tables[0].Rows[0]["Recipe_Ingredients"])
                @*<ul class="ml-4">
                    <li>1 cup Buckwheat Groats</li>
                    <li>2 cups Water</li>
                </ul>*@
            </div>
            <div class="col-md-8 mt-5 pl-4 pr-4 pt-3 pb-3 bg-light border-light-gray bottom-met-blk">
                <h4>Method</h4>
                @Html.Raw(Model.Tables[0].Rows[0]["Recipe_Method"])
                @*<ol class="ml-4">
                    <li>Combine 1 cup buckwheat groats and 2 cups water in a pot. Bring to a boil; cover, reduce heat to simmer and cook until tender, about 10 minutes.</li>
                    <li>Drain off any excess liquid. If using in a salad, rinse with cold water and drain well. Makes about 2-1/2 cups.</li>
                </ol>*@
            </div>
            @if (Model.Tables[0].Rows[0]["Recipe_BakingTip"].ToString() != "")
            {
            <div class="col-md-12 mt-4 pl-4 pr-4 pt-3 pb-3">
                <h4>Baking Tips</h4>
                <span>@Model.Tables[0].Rows[0]["Recipe_BakingTip"].ToString()</span>
            </div>
            }

        </div>
    </div>
</section>
<section>
    <div class="container">
        <div class="row">
            <div id="shop" class="col-md-12 mt-3 mb-4">
                <div class="clear"></div>
                @if (Model.Tables[1].Rows.Count > 0)
                {
                    <div class="line"></div>
                    <div class="container">
                        <div id="shop" class="col_full">

                            <h4>Recipe Related Products</h4>

                            <div id="oc-product" class="shop relate-prod relproducts owl-carousel product-carousel carousel-widget" data-margin="30" data-pagi="false" data-autoplay="5000" data-items-xs="1" data-items-md="2" data-items-lg="3" data-items-xl="4">


                                @foreach (DataRow row in Model.Tables[1].Rows)
                                {
                                    string title = "", onelinedesc = "";
                                    var tcount = row["Product_Name"].ToString().Length;

                                    if (tcount > 35)
                                    {
                                        title = @Convert.ToString(row["Product_Name"]).Substring(0, 35) + "...";
                                    }
                                    else
                                    {
                                        title = @Convert.ToString(row["Product_Name"]);
                                    }
                                    var Ocount = row["Product_Usage"].ToString().Length;
                                    if (Ocount > 35)
                                    {
                                        onelinedesc = @Convert.ToString(row["Product_Usage"]).Substring(0, 35) + "...";
                                    }
                                    else
                                    {
                                        onelinedesc = @Convert.ToString(row["Product_Usage"]);
                                    }
