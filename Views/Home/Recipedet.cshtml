@using System.Data
@using SwissbakeIn.App_Start;
@model DataSet
@{
    //string imageBasePath = "https://b2b.swissbake.bh/";
    string imageBasePath = System.Configuration.ConfigurationManager.AppSettings["cdndomain"];
    // "https://b2b.swissbake.bh/";

    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];


    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
    string img;
    if (Model.Tables[0].Rows.Count > 0)
    {
        img  = ViewBag.Domain  + Convert.ToString(Model.Tables[0].Rows[0]["Recipe_ImgPath"]);
        ViewBag.Title = Model.Tables[0].Rows[0]["Recipe_Seotitle"];
    }
    else
    {
        ViewBag.Title = "Recipe detail";
        img = ViewBag.Domain+"images/noimage.jpg";
    }
    }


@section seo{
    <meta http-equiv="Last-Modified" content="4/23/2019 7:30:06 AM" />
    <meta property="og:title" content="@Model.Tables[0].Rows[0]["Recipe_Seotitle"]" />
    <meta name="Title" content="@Model.Tables[0].Rows[0]["Recipe_Seotitle"]" />
    <meta name="description" content="@Model.Tables[0].Rows[0]["Recipe_Seodesc"]" />
    <meta name="keywords" content="@Model.Tables[0].Rows[0]["Recipe_Seokeywords"]" />
    <meta property="og:description" content="@Model.Tables[0].Rows[0]["Recipe_Seodesc"]" />
    <meta property="og:url" content="http://swissbake.bh/recipe/@Model.Tables[0].Rows[0]["Recipe_Seourl"]" />
    <meta property="twitter:title" content="@Model.Tables[0].Rows[0]["Recipe_Seotitle"]" />
    <meta property="twitter:description" content="@Model.Tables[0].Rows[0]["Recipe_Seodesc"]" />
    <meta property="og:image" content="@ViewBag.Domain@Model.Tables[0].Rows[0]["Recipe_ImgPath"]" />
    <link rel="canonical" href="http://swissbake.bh/recipe/@Model.Tables[0].Rows[0]["Recipe_Seourl"]" />
}


