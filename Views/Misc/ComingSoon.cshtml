<script>

    function validate_email(email) {
        /* Define the recommended regular expression. */
        var emailExp = new RegExp(/^\b[A-Z0-9._%+-]+@@[A-Z0-9.-]+\.[A-Z]{2,4}\b$/i);

        /* Test the email given against the expression and return the result. */
        return emailExp.test(email);
    }
    function sendEmail() {



        $("#spnMessage").hide();
        // $("#formEmail").submit();

        var email = $("#inputemail").val();
        if (email == '') {
            $("#spnMessage").show();
            $("#spnMessage").addClass("text-white");
            $("#spnMessage").html("Please provide email");
            $("#inputemail").focus();
            return;
        }
        if (!validate_email(email)) {
            $("#spnMessage").show();
            $("#spnMessage").addClass("text-white");
            $("#spnMessage").html("Please provide valid email");
            $("#inputemail").focus();
            return;
        }
        $("#lblSendButton").html("Loading...");
        //#f37575
        $("#lblSendButton").addClass("att-disabled");
        $.post(`/misc/sendemail?email=${email}`, {}, function (d) {
            if (d.success) {
            
                $("#inputemail").text("");
                Swal.fire({
                    title: 'Success',
                    text: 'Thank you for your interest.',
                    icon: 'success',
                    confirmButtonText: 'Ok'
                })
                $("#lblSendButton").html("Subscribe");
                $("#lblSendButton").removeAttr("disabled");
                $("#lblSendButton").removeClass("att-disabled");
            } else {
              
                Swal.fire({
                    title: 'Error',
                    text: d.error_message,
                    icon: 'error',
                    confirmButtonText: 'Ok',
                    customClass: 'swal-wide',
                })
                $("#lblSendButton").html("Subscribe");
                $("#lblSendButton").removeClass("att-disabled");
            }
        })
    }
</script>