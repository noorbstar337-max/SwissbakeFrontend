                            <section>

                                <h4> Visit Frequency</h4>
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="0" id="star@(3*i+3)-null" @(int.Parse(Item["Rating_Understandability"].ToString()) == 0 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="1" id="star@(3*i+3)-1" @(int.Parse(Item["Rating_Understandability"].ToString()) == 1 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="2" id="star@(3*i+3)-2" @(int.Parse(Item["Rating_Understandability"].ToString()) == 2 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="3" id="star@(3*i+3)-3" @(int.Parse(Item["Rating_Understandability"].ToString()) == 3 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="4" id="star@(3*i+3)-4" @(int.Parse(Item["Rating_Understandability"].ToString()) == 4 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+3)" value="5" id="star@(3*i+3)-5" @(int.Parse(Item["Rating_Understandability"].ToString()) == 5 ? "checked" : "") />

                                <section class="ratingblock@(3*i+3)">
                                    <label for="star@(3*i+3)-1">
                                        <svg width="255" height="240" viewBox="0 0 51 48">
                                            <path d="m25,1 6,17h18l-14,11 5,17-15-10-15,10 5-17-14-11h18z" />
                                        </svg>
                                    </label>
                                    <label for="star@(3*i+3)-2">
                                        <svg width="255" height="240" viewBox="0 0 51 48">
                                            <path d="m25,1 6,17h18l-14,11 5,17-15-10-15,10 5-17-14-11h18z" />
                                        </svg>
                                    </label>
                                    <label for="star@(3*i+3)-3">
                                        <svg width="255" height="240" viewBox="0 0 51 48">
                                            <path d="m25,1 6,17h18l-14,11 5,17-15-10-15,10 5-17-14-11h18z" />
                                        </svg>
                                    </label>
                                    <label for="star@(3*i+3)-4">
                                        <svg width="255" height="240" viewBox="0 0 51 48">
                                            <path d="m25,1 6,17h18l-14,11 5,17-15-10-15,10 5-17-14-11h18z" />
                                        </svg>
                                    </label>
                                    <label for="star@(3*i+3)-5">
                                        <svg width="255" height="240" viewBox="0 0 51 48">
                                            <path d="m25,1 6,17h18l-14,11 5,17-15-10-15,10 5-17-14-11h18z" />
                                        </svg>
                                    </label>
                                </section>
                            </section>
                            <hr />
                            <h4>Remark</h4>
                            @Html.TextArea("Remark", @Item["Rating_Remark"].ToString(), new { @class = "form-control", @placeholder = "Enter Your Remark", @rows = 4, @readonly = "readonly" })
                            @*<textarea type="text" class="form-control;" style="width:100%" rows="4" placeholder="Text Message..."></textarea><br />*@
                            <br />
                        </div>
                        <hr class="new4" />
                    }

                    <div class="starbtn">
                        <button type="submit" class="btn btn-primary sub">Submit</button>
                    </div>

                </form>
            </div>
