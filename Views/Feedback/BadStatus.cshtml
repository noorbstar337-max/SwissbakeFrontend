                            <section>

                                <h4>Product Knowledge</h4>
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+2)" value="0" id="star@(3*i+2)-null" @(int.Parse(Item["Rating_Knowledge"].ToString()) == 0 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+2)" value="1" id="star@(3*i+2)-1" @(int.Parse(Item["Rating_Knowledge"].ToString()) == 1 ? "checked" : "") />
