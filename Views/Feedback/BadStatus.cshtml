                </a>
            </div>
            <div id="navbar6" class="navbar-collapse collapse top-nav">
                <ul class="nav navbar-nav navbar-right" style="margin-top:5px;">
                    <li><a target="_blank" href="https://www.tripjack.com/nav/">Home</a></li>
                    <li><a target="_blank" href="https://www.tripjack.com/nav/agent">Agents</a></li>
                    <li>
                        <a target="_blank"
                           href="https://www.tripjack.com/nav/distributor">Distributors</a>
                    </li>
                    <li><a target="_blank" href="https://www.tripjack.com/nav/supplier">Suppliers</a></li>
                    <li>
                        <a target="_blank"
                           href="https://www.tripjack.com/nav/testimonials">Testimonials</a>
                    </li>
