    <div class="container mainstyle">
        <div class="row">
            <div class="col-md-6 col-md-offset-3 maindiv">
                <div class="text-center">
                    <h3 style="text-transform: uppercase; font-weight: 600;">Feedback History</h3>
                </div><br />
                <form action="/Feedback/SaveBadReview" method="post">
                    @foreach (DataRow Item in Model.Rows)
                    {
                        { i = i + 1; }
                        <div style="display:flex;background: #4d4d4d;color: #fff;padding: 0 10px;">
                            <h4>Your feedback was on @Item["Rating_CreateDate"]</h4>
                            <input type="hidden" name="RatingId@(i)" value="@Item["Rating_Id"]" />
                            <input type="checkbox" name="checkbox1@(i)" value="" style="margin: 12px 10px;">
                        </div>
                        <br />
                        <div id="divid">
                            <table class="grayscale  @ViewBag.feedbackid" border="0" cellspacing="0" cellpadding="0" style=" width: 100%;">
                                <tbody>
                                    <tr class="listhead">
                                        <td class="pagestyle5"><br></td>
                                        <td class="pagestyle4"><br></td>
                                        <td class="pagestyle3"><br></td>
                                        <td class="pagestyle2"><br></td>
                                        <td class="pagestyle1"><br></td>
                                    </tr>
                                    <tr class="listhead1">
                                        <td class="pagetab5">
                                            <p class="MsoNormal">
                                                <span>Excellent</span>
                                                @*<a href="@Url.Action("BadStatus/Feedback", new { @feedbackid = "5", AgentId = @ViewBag.AgentId})">

                                                    </a>*@

                                            </p>
                                        </td>
                                        <td class="pagetab4">
                                            <p class="MsoNormal">
                                                <span>Good</span>
                                                @*<a href="@Url.Action("BadStatus/Feedback", new { @feedbackid = "4", AgentId = @ViewBag.AgentId })">

                                                    </a>*@

                                            </p>
                                        </td>
                                        <td class="pagetab3">
                                            <p class="MsoNormal">
                                                <span>Just okay</span>
                                                @*<a href="@Url.Action("BadStatus/Feedback", new { @feedbackid = "3", AgentId = @ViewBag.AgentId })">

                                                    </a>*@

                                            </p>
                                        </td>
                                        <td class="pagetab2">
                                            <p class="MsoNormal">
                                                <span>Can improve</span>
                                                @*<a href="@Url.Action("BadStatus/Feedback", new { @feedbackid = "2", AgentId = @ViewBag.AgentId})">

                                                    </a>*@

                                            </p>
                                        </td>
                                        <td class="pagetab1">
                                            <p class="MsoNormal">
                                                <span>Bad</span>
                                                @*<a href="@Url.Action("BadStatus/Feedback", new { @feedbackid = "1", AgentId = @ViewBag.AgentId})">

                                                    </a>*@

                                            </p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <section>

                                <h4>Responsive</h4>
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+1)" value="0" id="star@(3*i+1)-null" @(int.Parse(Item["Rating_Listening"].ToString()) == 0 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+1)" value="1" id="star@(3*i+1)-1" @(int.Parse(Item["Rating_Listening"].ToString()) == 1 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+1)" value="2" id="star@(3*i+1)-2" @(int.Parse(Item["Rating_Listening"].ToString()) == 2 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+1)" value="3" id="star@(3*i+1)-3" @(int.Parse(Item["Rating_Listening"].ToString()) == 3 ? "checked" : "") />
                                <input onclick="return false;" style="display:none" type="radio" name="star@(3*i+1)" value="4" id="star@(3*i+1)-4" @(int.Parse(Item["Rating_Listening"].ToString()) == 4 ? "checked" : "") />
