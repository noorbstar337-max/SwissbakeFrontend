@using System.Data;
@model DataSet
@*@model dynamic*@
@{
    ViewBag.Title = "My Company Details";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}

@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    @Styles.Render("~/Content/Rev")
}

@section foot{
    <script src="~/Content/js/register/jquery.validate.min.js"></script>
    <script src="~/Content/js/account.js"></script>
    @Scripts.Render("~/bundles/Rev")
    <script>
        $(document).ready(function () {
            @Html.Raw(ViewBag.error)


            $("#Profile input").keyup(function () {
                var val = $(this).val();
                if (val && val != "" && $(this).attr("type") != 'password' && $(this).attr("name") != "emailid") {
                    val = val.toUpperCase();
                }
                $(this).val(val);

            })

        });

        function sucess() {
            $.confirm({
                backgroundDismiss: false,
                title: false,
                content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">Profile updated successfully</label></div>',
                buttons: false
            });
            setTimeout(function () {
                $('.jconfirm-closeIcon').click();
            }, 5000);
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("select.sm-form-control").forEach(function (dropdown) {
                for (let i = 0; i < dropdown.options.length; i++) {
                    dropdown.options[i].text = dropdown.options[i].text.toUpperCase();
                }
            });
        });
    </script>




}

@Html.Partial("_AccountMenu")

@if (Model.Tables["TbBanner"].Rows.Count > 0)
{

    <section id="slider" class="slider-element revslider-wrap clearfix pt-9 mb-0">
        <div class="rev_slider_wrapper topslider">
            <!-- START REVOLUTION SLIDER 5.0 auto mode -->
            <div id="rev_slider" class="rev_slider" data-version="5.0">
                <ul>
                    <!-- SLIDE  -->
                    @foreach (DataRow row in Model.Tables["TbBanner"].Rows)
                    {
                        string img = ViewBag.Domain + Convert.ToString(row["Banner_ImgPath"]);
                        <li data-transition="fade">
                            <!-- MAIN IMAGE -->
                            <a class="rev-link" href="@row["Banner_Url"]">
                                <img src="@img">
                                <!-- LAYER NR. 1 -->
                                <div class="tp-caption News-Title   tp-resizeme rs-parallaxlevel-0"
                                     data-x="left" data-hoffset="80"
                                     data-y="top" data-voffset="450"
                                     data-whitespace="normal"
                                     data-transform_idle="o:1;"
                                     data-transform_in="o:0"
                                     data-transform_out="o:0"
                                     data-start="500">

                                </div>
                            </a>
                        </li>

                    }

                </ul>
            </div><!-- END REVOLUTION SLIDER -->
        </div><!-- END REVOLUTION SLIDER WRAPPER -->

    </section>
}
<section class="@(Model.Tables["TbBanner"].Rows.Count > 0 ? "" : "pt-9")">
    <div class="bg-light pt-3 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="welcome-name heading-block mb-2">
                        <h4 class="mb-1">
                            Welcome, @Session["U_Name"]
                        </h4>
                    </div>
                    <p class="mb-lg-1">This page contains information about your company and account.</p>
                    <a href="/account/index" class="btn-more-link float-lg-right">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="content">

