                        @*<span>Your Profile Bio</span>*@
                    </div>


                    <div class="clear"></div>


                    <div class="create_profile">

                        <form id="Profile" name="Profile" class="nobottommargin" action="" method="post">

                            @foreach (DataRow i in Model.Tables[0].Rows)
                            {
                                ViewBag.mail = i["Cust_EmailId"];
                                ViewBag.c = 1;
                                <div class="col_one_third">
                                    <label for="shipping-form-companyname">Company Name:</label>
                                    <input type="text" id="Companyname" name="Companyname" value="@i["Acc_Name"]" @(i["Acc_Name"].ToString() != "" ? "disabled='disabled' readonly" : "") class="sm-form-control" />
                                </div>

                                <div class="col_one_third">
                                    <label for="shipping-form-storename">Store Name:</label>
                                    <input type="text" id="storename" name="storename" value="@i["Cust_StoreName"]" class="sm-form-control" />
                                </div>

                            }




                            <div class="col_one_third col_last">
                                <label for="shipping-form-fullname">Designation:</label>



                                @Html.DropDownList("desig", (SelectList)ViewBag.desiglist, "None", new { @class = "sm-form-control", })
