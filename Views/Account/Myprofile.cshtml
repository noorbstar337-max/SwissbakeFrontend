                            <div class="clear"></div>

                            @foreach (DataRow i in Model?.Tables[1]?.Rows)
                            {

                                if (ViewBag.c == 1)
                                {
                                    <div class="col_one_third">
                                        <label for="shipping-form-fullname">Full Name:</label>
                                        <input type="text" id="fullname" name="fullname" value="@i["Contact_ContactPerson"]" onkeypress="return charkey(this);" class="sm-form-control" />
                                    </div>

                                    <div class="col_one_third">
                                        <label for="shipping-form-email">Email Address:</label>
                                        <input type="email" id="emailid" name="emailid" value="@ViewBag.mail.ToString().ToUpper()" class="sm-form-control" disabled="disabled" />
                                    </div>

                                    <div class="col_one_third col_last">
                                        <label for="shipping-form-phone">Mobile: (+973)</label>
                                        <input type="text" id="mob" name="mob" value="@i["Contact_Mobile"]" maxlength="10" minlength="8" class="sm-form-control" onkeypress="return numkey(this);" disabled="disabled" />
                                    </div>

                                    <div class="clear"></div>

                                    @*<div class="col_one_third col_last">
                                            <label for="shipping-form-telephone">Telephone:</label>
                                            <input type="text" id="telephone" name="telephone" value="@i["Contact_Landline"]" maxlength="12" onkeypress="return numkey(this);" class="sm-form-control" />
                                        </div>*@
                                }
                                ViewBag.c = 2;
                            }




                            <div class="clear"></div>

                            <div class="w-100 bottommargin"></div>



                            <div class="heading-block">
                                <h4>Billing Address</h4>
                            </div>
                            @{ int ind = 0; }
                            @foreach (DataRow i in Model?.Tables[2]?.Rows)
                            {
                                if (ind > 0)
                                {
                                    break;
                                }
                                ind++;
                                <div class="col_one_third">
                                    <label for="billing-form-billingname">Billing Name:</label>
                                    <input type="text" id="BillingName" name="BillingName" value="@i["AccAddr_Name"]" @(i["AccAddr_Name"].ToString() != "" ? "disabled='disabled' readonly" : "") onkeypress="return charkey(this);" class="sm-form-control" />
                                </div>

                                <div class="col_one_third">
                                    <label for="billing-form-email">Email Address:</label>
                                    <input type="email" id="Email" name="Email" value="@i["AccAddr_Email"]" class="sm-form-control" />
                                </div>

                                <div class="col_one_third col_last">
                                    <label for="billing-form-phone">Mobile: (+973)</label>
                                    <input type="text" id="Mobile" name="Mobile" value="@i["AccAddr_Telephone"]" maxlength="10" minlength="8" onkeypress="return numkey(this);" class="sm-form-control" />
                                </div>

                                <div class="col_two_third">
                                    <label for="billing-form-street">Address:</label>
                                    <input type="text" id="StreetName" name="StreetName" value="@i["AccAddr_Address"]" class="sm-form-control" />
                                </div>

                                <div class="col_one_third col_last">
                                    <label for="billing-form-pin">Pin Code:</label>
                                    <input type="text" id="pinCode" name="pinCode" value="@i["AccAddr_Pincode"]" class="sm-form-control" maxlength="10" onkeypress="return numkey(this);" />
                                </div>



                                <div class="col_one_third">
                                    <label for="billing-form-city">City / Town:</label>
                                    <input type="text" id="City" name="City" value="@i["AccAddr_City"]" class="sm-form-control" onkeypress="return charkey(this);" />
                                </div>
                            }
                            <div class="col_one_third" style="display:block;">
                                <label for="billing-form-state">State:</label>
                                @Html.DropDownList("State", (SelectList)ViewBag.sttlist, "", new { @class = "sm-form-control ", })
                                @*<select class="sm-form-control" id="">
                                        <option>Maharashtra</option>
                                        <option>Andhra Pradesh</option>
                                        <option>Gujarat</option>
                                        <option>Haryana</option>
                                        <option>Assam</option>
                                    </select>*@
                            </div>


                            <div class="col_one_third col_last">


                                <label for="billing-form-country">Country:</label>
                                @Html.DropDownList("country", (SelectList)ViewBag.cntrylist, new { @class = "sm-form-control", @disabled = "disabled" })
                                @*<select class="sm-form-control" id="">
                                        <option>Bahrain</option>
                                        <option>China</option>
                                        <option>Australia</option>
                                        <option>Russia</option>
                                        <option>Germany</option>
                                    </select>*@
                            </div>

                            <div class="clear"></div>

                            <div class="w-100 bottommargin"></div>


                            <div class="heading-block">
                                <h4>Taxation Details</h4>
                            </div>
                            @foreach (DataRow i in Model.Tables[3].Rows)
                            {
                                <div class="col_half">
                                    <label for="pannumber">CR Number:</label>
                                    <input type="text" id="pan" name="pan" maxlength="10" value="@i["cust_Pan"]" @(i["cust_Pan"].ToString() != "" && i["cust_Pan"].ToString() != "-" ? "disabled='disabled' readonly" : "") class="sm-form-control" />
                                </div>

                                <div class="col_half col_last">
                                    <label for="gstnumber">VAT Number:</label>
                                    <input type="text" id="gst" name="gst" minlength="10" maxlength="15" value="@i["cust_gst"]" @(i["cust_gst"].ToString() != "" ? "disabled='disabled' readonly" : "") class="sm-form-control" />
                                </div>
                            }

                            <div class="col_full nobottommargin">
                                <button type="submit" class="button  nomargin save" value="Update">Update</button>
                                <a href="/account/index" class="button  nomargin cancel" value="Cancel">Cancel</a>
                            </div>
                        </form>

                    </div>

                </div>


