@using System.Data;
@model DataSet
@{
    ViewBag.Title = "KYC Documents";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}

@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
<style>
    .jconfirm .jconfirm-box div.jconfirm-content-pane {
        margin-bottom: 0;
    }

    .jconfirm-closeIcon {
        display: none !important;
    }

    label.error {
        position: absolute;
        left: 10px;
        bottom: -22px;
        font-size: 12px;
    }
    @@media screen and (max-width:374px){
        label.error {
            bottom: -20px;
            font-size:10.5px;
        }
    }

</style>
@*<link href="~/Content/css/custom3.css" rel="stylesheet" />*@
@Styles.Render("~/Content/Rev")
}

@section foot{
    @*<script src="~/Content/js/account.js"></script>*@


<script src="~/Content/js/register/jquery.validate.min.js"></script>

<script>

    $(document).ready(function () {

        $(".form-control-file").on("change", function () {
            
            if (this.value != "" && this.value != undefined){
                $(this).parent().parent().children("a").addClass("d-none");
                $(this).parent().parent().children("label.text-danger").remove();
                //$(this.parentNode.parentNode.children("")).remove();
                $('<label class="text-success" title="Selected"><i class="fas fa-check-circle"></i></label>').appendTo(this.parentNode.parentNode);
                //$(this).parent().insertAfter();
            }
            else {
                $(this).parent().parent().children("a").addClass("d-none");
                $(this).parent().parent().children("label.text-success").remove();
                $('<label class="text-danger" title="Selected"><i class="fas fa-times-circle"></i></label>').appendTo(this.parentNode.parentNode);
            }

        });



        // Code for the Validator
        var form = $('form');
        var error = $('.form-group', form);

        $.validator.addMethod(
            "regex",
            function (value, element, regexp) {
                var re = new RegExp(regexp);
                if (re.test(value)){

                }
                else {
                    $("label.text-success").remove();
                }
                return this.optional(element) || re.test(value);
            },
            "This is invalid"
        );



        var $validator = $('form').validate({
            //doNotHideMessage: true, //this option enables to show the error/success messages on tab switch.
            //errorElement: 'span', //default input error message container
            //errorClass: 'error-block1', // default input error message class
            //focusInvalid: false, // do not focus the last invalid input
            rules: {
                file1: {
                    regex: /\.(docx|doc|pdf|jpg)$/
                },
                file2: {
                    regex: /\.(docx|doc|pdf|jpg)$/
                },
                file3: {
                    regex: /\.(docx|doc|pdf|jpg)$/
                }

            },

            messages: {
                
                file1: {
                    regex: "Please upload (DOCX | PDF | DOC | JPG)"
                },
                file2: {
                    regex: "Please upload (DOCX | PDF | DOC | JPG)"
                },
                file3: {
                    regex: "Please upload (DOCX | PDF | DOC | JPG)"
                }
            },

            errorPlacement: function (error, element) {
                if (element.attr("name") == "typeoption") { // for uniform radio buttons, insert the after the given container
                    error.insertAfter("#show-error");
                }
                //else if (element.attr("name") == "payment[]") { // for uniform checkboxes, insert the after the given container
                //    error.insertAfter("#form_payment_error");
                //}
                else {
                    error.insertAfter(element.parent()); // for other inputs, just perform default behavior
                }
                //element.parent().removeClass("btn-file");
                //error.insertAfter(element.parent().parent().children("a"));
                //setTimeout(function () {
                //    element.parent().addClass("btn-file");
                //},10);
                
                
            },
            //success: function (label) {
            //    if (label.attr("for") == "typeoption") { // for checkboxes and radio buttons, no need to show OK icon
            //        label.remove(); // remove error label here
            //    }
            //},
            submitHandler: function (form) {
                var $valid = $('form').valid();

                if (!$valid) {
                    $validator.focusInvalid();

                    return false;
                }
                else {
                    
                    var cont = 0;
                    for (var i = 0; i <= $(".form-control-file").length; i++){
                        if ($(".form-control-file")(i).val() != ""){
                            cont = cont + 1
                        }
                        
                    }

                    if (cont > 0){
                        $("button[type=submit]").text("Saving...").attr("disabled", "disabled");
                        $("button[type=reset]").attr("disabled", "disabled");
                    //angular.element(document.getElementById('content')).scope().submitForm();
                    //angular.element(document.getElementById('content')).scope().$apply();
                    form.submit()
                    }
                    else {
                        $.confirm({
                            backgroundDismiss: false,
                            title: false,
                            content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">Please choose atleast 1 file.</label></div>',
                            buttons: false

                        });
                        setTimeout(function () {
                            $('.jconfirm-closeIcon').click();
                        }, 5000);
                    }
                    
                }
                //add here some ajax code to submit your form or just call form.submit() if you want to submit the form without ajax
            }
        });

        @Html.Raw(ViewBag.error)


    });


    function sucess() {
        $.confirm({
            backgroundDismiss: false,
            title: false,
            content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">The document updated successfully.</label></div>',
            buttons: false
        });
        setTimeout(function () {
            $('.jconfirm-closeIcon').click();
        }, 5000);
    }

</script>
<script src="~/Content/js/account.js"></script>
@Scripts.Render("~/bundles/Rev")


}

@Html.Partial("_AccountMenu")

