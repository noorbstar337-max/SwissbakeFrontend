                                     data-transform_idle="o:1;"
                                     data-transform_in="o:0"
                                     data-transform_out="o:0"
                                     data-start="500">

                                </div>
                            </a>
                        </li>

                    }

                    
                </ul>
            </div><!-- END REVOLUTION SLIDER -->
        </div><!-- END REVOLUTION SLIDER WRAPPER -->

    </section>
}
<section class="@(Model?.Tables["Tb2"]?.Rows?.Count > 0 ? "" : "pt-9")">
    <div class="bg-light pt-3 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="welcome-name heading-block mb-2">
                        <h4 class="mb-1">
                            Welcome, @Session["U_Name"]
                        </h4>
                    </div>
                    <p class="mb-lg-1">This section allows you to update your KYC related document.</p>
                    <a href="/account/index" class="btn-more-link float-lg-right">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</section>

    <section id="content">

        <div class="content-wrap">

            <div class="container clearfix">

                <div class="row clearfix">

                    <div class="col-md-8 m-auto pr-0">

                        <div class="heading-block">
                            <h4>UPLOAD KYC DOCUMENTS</h4>
                        </div>

                        @using (Html.BeginForm("Kyc", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            
                            <div class="form-group row position-relative mb-4">
                                <label for="" class="col-12">User Photo ID  :<br /><small>(We accept Personal PAN Card or AADHAR Card)</small></label>
                                @*@(Model.Tables[0].Rows[0]["Doc_Id"].ToString() == "" ? "" : Model.Tables[0].Rows[0]["Doc_Id"])*@
                                @Html.Hidden("doc1", Model.Tables[0].Rows[2]["Doc_Id"])
                                @Html.Hidden("docmg1", Model.Tables[0].Rows[2]["Doc_Path"])
                                <label class="btn-file col-3">
                                    <span style="position: absolute;left: 0;width:100%;z-index: 9;">ATTACH</span>
                                    <input type="file" class="form-control-file op-0" id="file1" name="file1">
                                </label>
                                @if (Model.Tables[0].Rows[2]["Doc_Path"].ToString() != "") { <a href="@Model.Tables[0].Rows[2]["Doc_Path"].ToString()" target="_blank" class="text-dark mr-lg-3" title="View"><i class="fa fa-file" aria-hidden="true"></i></a> }
                            </div>
                            <div class="form-group row position-relative mb-4">
                                <label for="" class="col-12">Company Proof  :<br /><small>(We accept MOA, AOA or VAT registration certificate)</small></label>
                                @Html.Hidden("doc2", Model.Tables[0].Rows[1]["Doc_Id"])
                                @Html.Hidden("docmg2", Model.Tables[0].Rows[1]["Doc_Path"])
                                <label class="btn-file col-3">
                                    <span style="position: absolute;left: 0;width:100%;z-index: 9;">ATTACH</span>
                                    <input type="file" class="form-control-file op-0" id="file2" name="file2">
                                </label>
                                @if (Model.Tables[0].Rows[1]["Doc_Path"].ToString() != "") { <a href="@Model.Tables[0].Rows[1]["Doc_Path"].ToString()" target="_blank" class="text-dark mr-lg-3" title="View"><i class="fa fa-file" aria-hidden="true"></i></a> }
                            </div>
                            <div class="form-group row position-relative mb-4">
                                <label for="" class="col-12">Owner/Promoter/Proprietor Address Proof  :<br /><small>(We accept AADHAR CARD for any one owner or director)</small></label>
                                @Html.Hidden("doc3", Model.Tables[0].Rows[0]["Doc_Id"])
                                @Html.Hidden("docmg3", Model.Tables[0].Rows[0]["Doc_Path"])
                                <label class="btn-file col-3">
                                    <span style="position: absolute;left: 0;width:100%; z-index: 9;">ATTACH</span>
                                    <input type="file" class="form-control-file op-0" id="file3" name="file3">
                                </label>
                                @if (Model.Tables[0].Rows[0]["Doc_Path"].ToString() != "") { <a href="@Model.Tables[0].Rows[0]["Doc_Path"].ToString()" target="_blank" class="text-dark mr-lg-3" title="View"><i class="fa fa-file" aria-hidden="true"></i></a> }
                                
                            </div>

                            <div class="col_full nobottommargin">
                                <button type="submit" class="button  nomargin apply save" value="apply">Save</button>
                                @*<a href="/account/index" class="button  nomargin cancel" value="Cancel">Cancel</a>*@
                            </div>

                        }

                    </div>

                </div>

            </div>

        </div>

    </section>