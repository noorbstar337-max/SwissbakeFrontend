    <style>
        .jconfirm .jconfirm-box div.jconfirm-content-pane {
            margin-bottom: 0;
        }

        .jconfirm-closeIcon {
            display: none !important;
        }

        .rcptable th{
            background: #b31616;
            color: #fff;
        }

