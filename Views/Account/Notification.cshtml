        //    });
        //});

        var app = angular.module('MyApp', [])

        app.controller('notifi', function ($scope, $http, $window) {
            $scope.load = function () {
                $http({
                    method: "GET",
                    url: "/access/GetAllNotifi",
                    dataType: 'json',
                    //data: customer,
                    //headers: { "Content-Type": "application/json" }
                }).then(function (response) {
                    if (response.status == 200) {
                        $scope.Notifi = response.data;
                        $scope.al = "active";
                        $scope.r = "";
                        $scope.u = "";
                    }
                    loadmore();
                });
            }

            $scope.read = function () {
                var update = '{T: "True" }';
                $http({
                    method: "POST",
                    url: "/access/GetAllNotifi",
                    dataType: 'json',
                    data: update,
                    headers: { "Content-Type": "application/json" }
                }).then(function (response) {

                    if (response.status == 200) {
                        $scope.Notifi = response.data;
                        $scope.al = "";
                        $scope.r = "active";
                        $scope.u = "";
                    }
                    loadmore();
                });
            }

            $scope.unread = function () {
                
                var update = '{T: "False" }';
                $http({
                    method: "POST",
                    url: "/access/GetAllNotifi",
                    dataType: 'json',
                    data: update,
                    headers: { "Content-Type": "application/json" }
                }).then(function (response) {

                    if (response.status == 200) {
                        $scope.Notifi = response.data;
                        $scope.al = "";
                        $scope.r = "";
                        $scope.u = "active";
                    }
                    loadmore();
                });
            }


            $scope.load();

            $scope.update = function (i, id) {
                //alert(i + "/" + id);
                var update = '{Id: "' + id + '" }';

                if ($scope.Notifi[i].Status == "False") {
                    $http({
                        method: "POST",
                        url: "/access/UpdateNotifi",
                        dataType: 'json',
                        data: update,
                        headers: { "Content-Type": "application/json" }
                    }).then(function (response) {

                        if (response.status == 200) {
                            $scope.Notifi[i].Status = "True";

                            var count = $('#notifLcount').text();
                            count -= 1;
                            if (count > 0) {
                                $('#notifLcount').text(count);
                                $("#notifLcount").removeClass("d-none");
                                $('#notifScount').text(count);
                                $("#notifScount").removeClass("d-none");
                            }
                            else {
                                $('#notifLcount').text(count);
                                $("#notifLcount").addClass("d-none");
                                $('#notifScount').text(count);
                                $("#notifScount").addClass("d-none");
                            }
                        }
                        loadmore();
                    });
                }

                


            }

            $scope.isActive = false;
            $scope.open = function (band) {
                console.log($scope.isActive);
                $scope.isActive = !$scope.isActive;
            };


            $scope.limit = 52;

            $scope.showMore = function () {
                $scope.limit = 500;
            };
            $scope.setPageNumber = function (index) {
                $scope.pageNumber = index;
            }
            $scope.showLess = function () {
                $scope.limit = 52;
            };	


        });


        var revapi;
        $(document).ready(function () {
            revapi = $("#rev_slider").revolution({
                sliderType: "standard",
                sliderLayout: "fullwidth",
                delay: 5000,
                navigation: {
                    arrows: { enable: true }
                },
                gridwidth: 1230,
                gridheight: 300
            });
            revapi = $("#rev_slider2").revolution({
                sliderType: "standard",
                sliderLayout: "fullwidth",
                delay: 5000,
                navigation: {
                    arrows: { enable: true }
                },
                gridwidth: 1230,
                gridheight: 300
            });
        });	/*ready*/
    </script>
}

