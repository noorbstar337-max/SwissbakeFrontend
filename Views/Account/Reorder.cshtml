@using SwissbakeIn.Entities;
@using System.Data;
@model DataSet

@{ 
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}

@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    <link href="~/Content/css/components/bs-datatable.css" rel="stylesheet" />
@Styles.Render("~/Content/Rev")
    <style>
        .jconfirm .jconfirm-box div.jconfirm-content-pane {
            margin-bottom: 0;
        }

        .jconfirm-closeIcon {
            display: none !important;
        }
        .table-responsive{
            display:block;
        }
        .table-responsive td{
            border:none;
        }
    </style>
}

@section foot{
    @*<script src="~/Content/js/account.js"></script>*@
    <script src="~/Content/js/components/bs-datatable.js"></script>
    <script>

        $(document).ready(function () {
            $('#datatable1').dataTable({
                "order": [[2, "desc"]]
            } );
            getOrder($("select[name=Year]").val(), $("#type").val());
            $('select[name=Year]').change(function () {
                //$('button[name=yearsubmit]').click();
                getOrder($("select[name=Year]").val(), $("#type").val());
            });
        });
        function getOrder(year,type) {
             $.ajax({
                    url: '/access/@ViewBag.access',
                    type: "Post",
                    beforeSend: function () {
                        $.confirm({
                            backgroundDismiss: false,
                            title: false,
                            content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 21px;">Fetching Data... <i class="fas fa-circle-notch fa-spin"></i></label></div>',
                            buttons: false
                        });
                        //_divPartialView.style = "Display: none";
                        //$("#divWaiting").removeClass("display-none");
                },
                    data: { date: year, M: type},
                    success: function (response) {

                        //_divPartialView.style = "";
                        //$("#divWaiting").addClass("display-none");
                        $(".myordertbl").html(response);
                        $('#datatable1').dataTable({
                            "order": [[1, "desc"]],
                            "oLanguage": {
                                "sEmptyTable": "No record found"
                            }
                        });

                        var thcount = $(".table thead th").length;

                        var styl = "<style>"

                        for (var i = 1; i < thcount + 1; i++) {
                            var th = $(".table thead th:nth-child(" + i + ")").text();
                            if (th != '') {
                                styl = styl + ".table tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                            }

                        }

                        $("head").append(styl + "</style>");



                        setTimeout(function () {
                            $(".jconfirm-closeIcon").click();
                        }, 500);

                    }
                });
        }
    </script>
@Scripts.Render("~/bundles/Rev")
<script>
        var revapi;
        $(document).ready(function () {
            revapi = $("#rev_slider").revolution({
                sliderType: "standard",
