@using System.Data;
@using SwissbakeIn.App_Start;
@model DataSet
@{
    ViewBag.Title = "Dashboard";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}


@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    @Styles.Render("~/Content/Rev")
<style>
    .jconfirm .jconfirm-box div.jconfirm-content-pane {
        margin-bottom: 0;
    }

    /*.jconfirm-closeIcon {
        display: none !important;
    }*/
    .no-remind.no-notifi{
        display:none
    }
    
</style>
}

@section foot{
    <script src="~/Content/js/account.js"></script>
    <script src="~/Content/js/bind/dash.js"></script>
    @Scripts.Render("~/bundles/Rev")


    <script>
        $(document).ready(function () {
            //debugger;
            var thcount = $(".o-t thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".o-t thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".o-t tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");

            var thcount = $(".i-t thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".i-t thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".i-t tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");

            var thcount = $(".p-t thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".p-t thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".p-t tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");

            var thcount = $(".c-t thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".c-t thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".c-t tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");


            var thcount = $(".r-t thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".r-t thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".r-t tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");

        });
    </script>


    @if (ViewBag.mess != null)
    {
        <text>
            <script>
    $(document).ready(function () {
            $.dialog({
        title: false,
        content: "@ViewBag.mess.ToString()",
            closeIconClass: 'close-dialog',
        });
            setTimeout(function() {
            $(".close-dialog").click();
                }, 5000);


                

    })
            </script>
        </text>

    }




}


@section Req{
    <div class="side-sch d-none" >
        <div class="widget clearfix">

            <h4>Edit Reminder</h4>

            <div class="mt-3">

                <form id="subs-form" action="" method="post">
                    <input name="redirect" id="redirect" class="d-none" value="@Request.Url.AbsolutePath" />
                    <input type="hidden" id="pid" name="pid"/>
                    <div class="row">
                        <div class="col-12 form-group">
                            <label class="sch-name"></label>
                        </div>
                        <div class="col-12 form-group">
                            <label class="label-floating">Requirement
                            </label>
                            @*<input type="text" id="Name" name="Name" placeholder="Name" class="form-control" />*@
                            <select name="schtype" class="form-control sch-type">
                                <option value="Monthly">Monthly</option>
                                <option value="Quarterly">Quarterly</option>
                                <option value="Custom">Customized</option>
                            </select>
                        </div>
                        <div id="subsdate" class="col-12 form-group">
                            <label class="label-floating">Day</label>
                            <select name="schdate" class="form-control sch-date">
                                <option>1</option>
                                <option>2</option>
                                <option>3</option>
                                <option>4</option>
                                <option>5</option>
                                <option>6</option>
                                <option>7</option>
                                <option>8</option>
                                <option>9</option>
                                <option>10</option>
                                <option>11</option>
                                <option>12</option>
                                <option>13</option>
                                <option>14</option>
                                <option>15</option>
                                <option>16</option>
                                <option>17</option>
                                <option>18</option>
                                <option>19</option>
                                <option>20</option>
                                <option>21</option>
                                <option>22</option>
                                <option>23</option>
                                <option>24</option>
                                <option>25</option>
                                <option>26</option>
                                <option>27</option>
                                <option>28</option>
                                <option>29</option>
                                <option>30</option>
                            </select>
                            <span class="error primary-color"></span>
                        </div>
                        <div class="col-12 form-group">
                            <label class="label-floating">Qty (KG)</label>
                            <input type="text" placeholder="Product quantity" name="schqty" class="form-control sch-qty" onkeypress="return numkey(this);" />
                        </div>
                    </div>
                    <button type="submit" class="btn bg-success pt-2 pb-2 pl-5 pr-5 text-white">Subscribe</button>
                </form>

                @*<a href="/login" class="bg-success pt-2 pb-2 pl-5 pr-5 text-white">Submit Request</a>*@
            </div>
        </div>

    </div>
}



