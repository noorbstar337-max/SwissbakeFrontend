<section class="@(Model.Tables[1].Rows.Count > 0 ? "" : "pt-9")">
    <div class="bg-light pt-3 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="welcome-name heading-block mb-2">
                        <h4 class="mb-1">
                            Welcome, @Session["U_Name"]
                        </h4>
                    </div>
                    <p class="mb-lg-1">This page will show you details of all the payments made against past purchases.</p>
                    <a href="/account/index" class="btn-more-link float-lg-right">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</section>
<section id="content">

    <div class="content-wrap">

        <div class="container clearfix">

            <div class="row" style="padding:15px">
                <div class="heading-block col-md-9">
                    <h4>@ViewBag.Title</h4>
                </div>
                @*<div class="col-md-2 cryr">
                        <span class="year">Year</span>
                    </div>*@

                @*<div class="col-md-2 yrdp">
                        <div class="form-group">
                            <select class="form-control" id="">
                                <option>2018</option>
                                <option>2017</option>
                                <option>2016</option>
                                <option>2015</option>
                                <option>2014</option>
                            </select>
                        </div>
                    </div>*@

                <div class="col-md-3">
                    <span class="year cryr">Year</span>
                    <div class="form-group yrdp">
                        <form action="" method="post">
                            <input type="text" id="type" style="display:none;" value="@ViewBag.mode" />
                            <select class="form-control" id="" name="Year">
                                @foreach (var item in ViewData["Year"] as List<CommonStruct>)
                                {
                                    if (ViewBag.sltyear == item.Datetime)
                                    {
                                        <option selected vlaue="@item.Datetime">@item.Datetime</option>
                                    }
                                    else if (item.Datetime == @DateTime.Now.Year.ToString())
                                    {
                                        <option selected vlaue="@item.Datetime">@item.Datetime</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Datetime">@item.Datetime</option>
                                    }

                                }
                                @*<option>2018</option>
                                    <option>2017</option>
                                    <option>2016</option>
                                    <option>2015</option>
                                    <option>2014</option>*@
                            </select>
                            <button name="yearsubmit" type="submit" class="d-none"></button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="table-responsive myordertbl">
                <table id="datatable1" class="table table-striped table-bordered" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th>Payment Date</th>
                            <th>Amount</th>
                            <th>Payment Mode</th>
                            @*<th>Pay Now</th>*@

                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Tables.Count > 0)
                        {
                            foreach (DataRow row in Model.Tables[0].Rows)
                            {
                                <tr>
                                    <td>@row["Payment_Date"]</td>
                                    <td>BHD @Helper.InPrice(Convert.ToDouble(row["Payment_Amount"]))</td>
                                    <td>@row["otherinfo"]</td>
                                    @*<td><button type="submit" class="paynow">Pay Now!</button></td>*@
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>

        </div>

    </div>

</section><!-- #content end -->
