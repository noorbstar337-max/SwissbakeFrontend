
@{
    ViewBag.Title = "Quickorder";
}

@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    <link href="~/Content/css/components/bs-datatable.css" rel="stylesheet" />
}

@section foot{
    <script src="~/Content/js/account.js"></script>
    <script src="~/Content/js/components/bs-datatable.js"></script>
<script src="~/Content/js/bind/quickorder.js"></script>
    @*<script>

            $(document).ready(function () {
                $('#datatable1').dataTable();
            });

        </script>*@
}
 

@Html.Partial("_AccountMenu")


<section id="content">

    <div class="content-wrap  pt-11">

        <div class="container clearfix">

            <div class="heading-block">
                <h4>Quick Order</h4>
            </div>

            <div class="w-100 bottommargin"></div>
            <div >

                <div class="row" id="MainCtrl" ng-controller="MainCtrl">
                    <div class="col-md-12">



                        <div class="table-responsive quickordertbl">
                            <table id="datatable1" class="table table-striped table-bordered" cellspacing="0" width="100%" ng-repeat="cat in QCat">
                                <thead>
                                    <tr>
                                        <th>{{cat.PrdCategory_Name}}</th>
                                        <th>Code</th>
                                        <th>Info</th>
                                        <th>SKU</th>
                                        <th>Rate/Kg</th>
                                        <th>No of Pack</th>
                                        <th>Kgs</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>

                                <tbody ng-controller="InsideCtrl as inside">
                                    <tr ng-repeat="state2 in inside.states2">
                                        <td>{{state2}}</td>
                                        <td>B13320</td>
                                        <td class="infocol"><i class="fas fa-file-pdf"></i><i class="fas fa-info-circle"></i></td>
                                        <td>5kg Bag</td>
                                        <td>BHD 325.000</td>
                                        <td><input type="text" value="" id=""></td>
                                        <td>-</td>
                                        <td>BHD -</td>
                                    </tr>


                                </tbody>
                            </table>
                        </div>



                    </div>



                </div>
            </div>
            <!-- /app -->
             
        </div>

    </div>


</section><!-- #content end -->
