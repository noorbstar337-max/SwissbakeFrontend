<section class="@(Model.Tables["Tb2"].Rows.Count > 0 ? "" : "pt-9")">
    <div class="bg-light pt-3 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="welcome-name heading-block mb-2">
                        <h4 class="mb-1">
                            Welcome, @Session["U_Name"]
                        </h4>
                    </div>
                    @*<p class="mb-lg-1">Welcome to the general support page. SwissBake® Team of experienced customer support, bakery technologists and professional
bakers are at your service. Share with us your baking concerns /queries so that our team of experts can guide you with the appropriate
solution.</p>*@

                    <p class="mb-lg-1">
                        This section will provide the details of all communications with our support team.
                    </p>
                    <a href="/account/index" class="btn-more-link float-lg-right">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</section>
<section id="content">

    <div class="content-wrap">

        <div class="container clearfix">
            <div class="row" style="padding:15px">
                <div class="heading-block col-md-10">
                    <h4>Support History</h4>
                </div>

                
            </div>
                

                <div class="casehistorytbl">

                    <div class="order-tabs w-100">

                        <ul>
                            <li class="@ViewBag.Act1"><a href="/account/gensupport">GENERAL&nbsp;SUPPORT</a></li>
                            <li class="@ViewBag.Act2"><a href="/account/feedback">FEEDBACK&nbsp;&&nbsp;COMPLAINT</a></li>
                            <li class="@ViewBag.Act3"><a href="/account/casehistory">SUPPORT&nbsp;HISTORY(@Model.Tables[1].Rows[0]["countCHistory"])</a></li>

                        </ul>
                        <select class="form-control mb-5" onchange="window.location.href=this.value">
                            <option value="/account/gensupport" @ViewBag.Act1>GENERAL&nbsp;SUPPORT</option>
                            <option value="/account/feedback" @ViewBag.Act2>FEEDBACK&nbsp;OR&nbsp;COMPLAINT</option>
                            <option value="/account/casehistory" @ViewBag.Act3>SUPPORT&nbsp;HISTORY(@Model.Tables[1].Rows[0]["countCHistory"])</option>
                        </select>

                    </div>

                    <table id="datatable1" class="table table-striped table-bordered table-responsive trac-tbl" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>Reference&nbsp;Number</th>
                                <th>Submit&nbsp;Date</th>
                                <th>Subject/Info</th>
                                <th>Status</th>

                            </tr>
                        </thead>

                        <tbody>
                            @foreach (DataRow item in Model.Tables[0].Rows)
                            {
                                <tr>
                                    <td><form action="/Account/SupportTicketview" method="post" class="m-0 p-0 nobg"><button value="@item["Complaint_ID"]" id="Tid" class="btn-id" name="Tid">@item["Complaint_ID"] <i class="fas fa-eye"></i></button>  </form></td>
                                    <td>@item["Complaint_CreatedDate"]</td>
                                    <td>@item["Complaint_Subject"]</td>
                                    <td>
                                        <span class="@Helper.GetStatus(item["Complaint_CompStatus"].ToString())">@item["Complaint_CompStatus"]</span>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

</section><!-- #content end -->