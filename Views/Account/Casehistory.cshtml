@using System.Data;
@using SwissbakeIn.App_Start;
@model DataSet

@{
    ViewBag.Title = "Support History";
    if (HttpContext.Current.Request.Url.Host == "localhost")
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["localdomain"];
    }
    else
    {
        ViewBag.Domain = System.Configuration.ConfigurationManager.AppSettings["domain"];
    }
}

@section head{
    <link href="~/Content/css/custom3.css" rel="stylesheet" />
    <link href="~/Content/css/components/bs-datatable.css" rel="stylesheet" />
    <style>
        @@media screen and (max-width: 640px){
            .table-responsive.trac-tbl tbody tr td {
                padding-left: 150px !important;
            }
        }


    </style>



@Styles.Render("~/Content/Rev")
}

@section foot{
    <script src="~/Content/js/account.js"></script>
    <script src="~/Content/js/components/bs-datatable.js"></script>
@Scripts.Render("~/bundles/Rev")
    <script>

        $(document).ready(function () {
            $('#datatable1').dataTable({
                "ordering": false,
                "oLanguage": {
                    "sEmptyTable": "No record found"
                }});
            @Html.Raw(ViewBag.error)

            var thcount = $(".table thead th").length;

            var styl = "<style>"

            for (var i = 1; i < thcount + 1; i++) {
                var th = $(".table thead th:nth-child(" + i + ")").text();
                if (th != '') {
                    styl = styl + ".table tbody td:nth-child(" + i + "):before{content:'" + th + "'} ";
                }

            }

            $("head").append(styl + "</style>");


        });

        function sucess() {
            $.confirm({
                backgroundDismiss: false,
                title: false,
                content: '<div class="checkbox" style="text-align:center;"><label style="font-size: 15px;">We have received your request, we will get back to you soon.</label></div>',
                buttons: false
            });
            setTimeout(function () {
                $('.jconfirm-closeIcon').click();
            }, 5000);
        }
    </script>
}

@Html.Partial("_AccountMenu")

