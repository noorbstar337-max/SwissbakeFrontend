<div id="wrapper" class="clearfix">

    <!-- Content
            ============================================= -->
    @if (Model.Tables[0].Rows.Count > 0)
    {

        <section id="slider" class="slider-element revslider-wrap clearfix pt-9 mb-0">
            <div class="rev_slider_wrapper topslider">
                <!-- START REVOLUTION SLIDER 5.0 auto mode -->
                <div id="rev_slider" class="rev_slider" data-version="5.0">
                    <ul>
                        <!-- SLIDE  -->
                        @foreach (DataRow row in Model.Tables[0].Rows)
                        {
                            string img = ViewBag.Domain + Convert.ToString(row["Banner_ImgPath"]);
                            <li data-transition="fade">
                                <!-- MAIN IMAGE -->
                                <a class="rev-link" href="@row["Banner_Url"]">
                                    <img src="@img">
                                    <!-- LAYER NR. 1 -->
                                    <div class="tp-caption News-Title   tp-resizeme rs-parallaxlevel-0"
                                         data-x="left" data-hoffset="80"
                                         data-y="top" data-voffset="450"
                                         data-whitespace="normal"
                                         data-transform_idle="o:1;"
                                         data-transform_in="o:0"
                                         data-transform_out="o:0"
                                         data-start="500">

                                    </div>
                                </a>
                            </li>

                        }

                      
                    </ul>
                </div><!-- END REVOLUTION SLIDER -->
            </div><!-- END REVOLUTION SLIDER WRAPPER -->

        </section>
    }
