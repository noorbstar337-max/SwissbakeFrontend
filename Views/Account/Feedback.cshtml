<section id="content">

    <div class="content-wrap">

        <div class="container clearfix">

            <div class="row clearfix">

                <div class="col-md-12 m-auto">

                    <div class="heading-block">
                        <h4>PROVIDE FEEDBACK OR RAISE COMPLAINT</h4>
                    </div>

                    <div class="supp">
                        <div class="order-tabs p-0">

                            <ul>
                                <li class="@ViewBag.Act1"><a href="/account/gensupport">GENERAL&nbsp;SUPPORT</a></li>
                                <li class="@ViewBag.Act2"><a href="/account/feedback">FEEDBACK&nbsp;OR&nbsp;COMPLAINT</a></li>
                                <li class="@ViewBag.Act3"><a href="/account/casehistory">SUPPORT&nbsp;HISTORY(@Model.Tables["Tb2"].Rows[0]["countCHistory"])</a></li>
                            </ul>
                            <select class="form-control mb-5" onchange="window.location.href=this.value">
                                <option value="/account/gensupport" @ViewBag.Act1>GENERAL&nbsp;SUPPORT</option>
                                <option value="/account/feedback" @ViewBag.Act2>FEEDBACK&nbsp;OR&nbsp;COMPLAINT</option>
                                <option value="/account/casehistory" @ViewBag.Act3>SUPPORT&nbsp;HISTORY(@Model.Tables["Tb2"].Rows[0]["countCHistory"])</option>
                            </select>

                        </div>



                        @using (Html.BeginForm("Feedback", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="form-group">
                                <label for="">Department:</label>
                                @Html.DropDownList("dept", (SelectList)ViewBag.departlist, new { @class = "sm-form-control", })
                                @*<select class="sm-form-control" id="">
                                        <option>1</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                        <option>5</option>
                                    </select>*@
                            </div>

                            <div class="form-group">
                                <label for="">Subject:</label>
                                <select class="sm-form-control" id="subject" name="subject">
                                    <option Value="">--- Select Subject ---</option>
                                    <option value="WEBSITE SUPPORT">WEBSITE SUPPORT</option>
                                    <option value="ORDER SUPPORT">ORDER SUPPORT</option>
                                    <option value="SHIPPING SUPPORT">SHIPPING SUPPORT</option>
                                    <option value="PRODUCT SUPPORT">PRODUCT SUPPORT</option>
                                    <option value="NEW PRODUCT QUERY">NEW PRODUCT QUERY</option>
                                    <option value="SUGGESTIONS">SUGGESTIONS</option>
                                    <option value="RETURN REQUEST">RETURN REQUEST</option>
                                    <option value="PAYMENT SUPPORT">PAYMENT SUPPORT</option>
                                    <option value="BAKERY SUPPORT">BAKERY SUPPORT</option>
                                    <option value="OTHERS">OTHERS</option>

                                </select>
                            </div>

                            <div class="form-group">
                                <label for="">Description:</label>
                                <textarea class="sm-form-control" id="desc" name="desc" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label for="">Attachments:</label>
                                <input type="file" class="form-control-file" id="file" name="file">
                            </div>

                            <div class="col_full nobottommargin">
                                <button class="button  nomargin save" value="Save">submit</button>
                                <a href="/account/index" class="button  nomargin cancel" value="Cancel">cancel</a>
                            </div>
                        }
                    </div>




                </div>



            </div>

        </div>

    </div>

</section><!-- #content end -->