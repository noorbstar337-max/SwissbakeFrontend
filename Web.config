<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="resizer" type="ImageResizer.ResizerSection" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="connectionString" connectionString="put your local database credenial" />
    
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="frontdomain" value="https://www.swissbake.bh/" />
    <add key="domain" value="https://b2b.swissbake.bh/" />
    <add key="cdndomain" value="http://www.swissbakebahrain.com/" />
    <add key="localdomain" value="https://localhost:50372/" />
    <add key="freightvalue" value="0" />
    <add key="reCaptchaPublicKey" value="6Lc6FQoUAAAAADhpVHIOE38hCpHScuZErvFnF92s" />
    <add key="reCaptchaPrivateKey" value="6Lc6FQoUAAAAAAHh3R4-r1zepMGVz_3WlwE3lJ4V" />
    <!--<add key="Compression" value="true" />-->
    <!--faisal added for gzip-->
    <add key="EmailFrom" value="noreply@swissbakebahrain.com" />
    <!--<add key="EmailPassword" value="Swi$$8@k3"/>-->
    <!--<add key="EmailPassword" value="@jK7cfif"/>-->
    <add key="EmailPassword" value="Swi$$@k3" />
    <!--qxiVKA1XYLAM" /-->
    <add key="EmailTo" value="info@swissbake.bh" />
    <add key="OngoingSMTP" value="smtp.zoho.in" />
    <add key="OngoingPOSRTSSL" value="587" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
  <pages validateRequest="false" />
  
        <httpRuntime targetFramework="4.7" requestPathInvalidCharacters="" />
      </system.Web>
  -->
  <system.web>
    <pages>
      <controls>
        <add assembly="MSCaptcha" namespace="MSCaptcha" tagPrefix="cc1" />
      </controls>
    </pages>
    <httpHandlers>
      <add verb="GET" path="CaptchaImage.axd" type="MSCaptcha.CaptchaImageHandler, MSCaptcha" />
    </httpHandlers>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.6" maxRequestLength="20480" />
    <httpModules>
      <add name="ImageResizingModule" type="ImageResizer.InterceptModule" />
    </httpModules>
    <!--<customErrors mode="Off">
      <error statusCode="404" redirect="~/Error/NotFound"/>
    <customErrors mode="Off"/>
    </customErrors>-->
    <customErrors mode="Off" defaultRedirect="~/misc/PageNotFound">
      <error statusCode="404" redirect="~/misc/PageNotFound" />
      <error statusCode="500" redirect="~/misc/PageNotFound" />
      <error statusCode="302" redirect="~/misc/PageNotFound" />
    </customErrors>
    <!--<customErrors mode="Off" />-->
  </system.web>
  <system.webServer>
    <!--<urlCompression doDynamicCompression="true" />-->
    <!--faisal added for gzip-->
    <modules runAllManagedModulesForAllRequests="true">
      <add name="ImageResizingModule" type="ImageResizer.InterceptModule" />
    </modules>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="3000000000" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="http-to-https" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
